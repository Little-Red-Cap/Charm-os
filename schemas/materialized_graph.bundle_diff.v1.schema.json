{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/materialized_graph.bundle_diff.v1.schema.json",
  "title": "materialized_graph.bundle_diff/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "include_unchanged",
    "left",
    "right",
    "status_counts",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "materialized_graph.bundle_diff/v1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "include_unchanged": {
      "type": "boolean"
    },
    "left": {
      "$ref": "#/$defs/bundleRef"
    },
    "right": {
      "$ref": "#/$defs/bundleRef"
    },
    "status_counts": {
      "$ref": "#/$defs/statusCounts"
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseDiff"
      }
    }
  },
  "$defs": {
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "bundle_root"
      ],
      "properties": {
        "index": {
          "type": "string"
        },
        "bundle_root": {
          "type": "string"
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "added",
        "removed",
        "unchanged"
      ],
      "properties": {
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "graphSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "node_count",
        "edge_count",
        "effective_max_phase",
        "effective_runlevel_mask",
        "effective_runlevel_text"
      ],
      "properties": {
        "schema": {
          "const": "materialized_graph.sample/v2"
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "effective_max_phase": {
          "type": "string"
        },
        "effective_runlevel_mask": {
          "type": "integer",
          "minimum": 0
        },
        "effective_runlevel_text": {
          "type": "string"
        },
        "node_kinds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "caseEntry": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "build_dir",
        "build_target",
        "export_target",
        "dot",
        "json",
        "graph"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "build_dir": {
          "type": "string"
        },
        "build_target": {
          "type": "string"
        },
        "export_target": {
          "type": "string"
        },
        "dot": {
          "type": "string"
        },
        "json": {
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/graphSummary"
        }
      }
    },
    "capabilityNameArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "kind",
        "phase",
        "runlevel",
        "provides",
        "requires"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "runlevel": {
          "type": "string"
        },
        "provides": {
          "$ref": "#/$defs/capabilityNameArray"
        },
        "requires": {
          "$ref": "#/$defs/capabilityNameArray"
        }
      }
    },
    "edgeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "provider",
        "consumer",
        "capability"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        }
      }
    },
    "changedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "fields",
        "left",
        "right"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/capabilityNameArray"
        },
        "left": {
          "$ref": "#/$defs/nodeView"
        },
        "right": {
          "$ref": "#/$defs/nodeView"
        }
      }
    },
    "nodeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeView"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeView"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changedNode"
          }
        }
      }
    },
    "edgeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edgeView"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edgeView"
          }
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caseDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "left_case",
        "right_case",
        "summary_changes",
        "node_changes",
        "edge_changes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "changed",
            "added",
            "removed",
            "unchanged"
          ]
        },
        "left_case": {
          "$ref": "#/$defs/caseEntry"
        },
        "right_case": {
          "$ref": "#/$defs/caseEntry"
        },
        "summary_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "node_changes": {
          "$ref": "#/$defs/nodeChanges"
        },
        "edge_changes": {
          "$ref": "#/$defs/edgeChanges"
        }
      }
    }
  }
}
