      "properties": {
        "source_result": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "baseline_summary_path": {
          "type": "string"
        },
        "candidate_summary_path": {
          "type": "string"
        },
        "baseline_result": {
          "type": "string"
        },
        "current_result": {
          "type": "string"
        },
