        "failed_result_transition": {
          "type": "boolean"
        },
        "blocked_open_transition": {
          "type": "boolean"
        },
        "action_id_changed": {
          "type": "boolean"
        },
        "action_kind_changed": {
          "type": "boolean"
        },
        "entry_changed": {
          "type": "boolean"
        },
        "target_changed": {
          "type": "boolean"
