set(PLAYER_PROFILE_SOURCE "")
set(PLAYER_PROFILE_IMPL_SOURCES "")
set(PLAYER_PROFILE_MODULE_GROUPS "")
set(PLAYER_PROFILE_COMPILE_DEFINITIONS "")

if (PLAYER_PROFILE STREQUAL "LEGACY_MAIN")
    set(PLAYER_PROFILE_SOURCE app/main.cpp)
    set(PLAYER_PROFILE_MODULE_GROUPS
        MODULE_GROUP_PRODUCT_CONFIG
        MODULE_GROUP_BASE
        MODULE_GROUP_PRODUCT_FS
        MODULE_GROUP_PRODUCT_AUDIO
        MODULE_GROUP_PRODUCT_DISPLAY
        MODULE_GROUP_PRODUCT_PLAYER_UI
        MODULE_GROUP_PRODUCT_LEGACY_RUNTIME)
