{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.biography_index.v0.schema.json",
  "title": "system_compiler.biography_index/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "profile",
    "shelf",
    "front_page",
    "delivery",
    "artifact_context",
    "summary",
    "entries",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.biography_index/v0"
    },
    "kind": {
      "const": "system_compiler.biography_index"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "profile": {
      "type": "string"
    },
    "shelf": {
      "$ref": "#/$defs/shelfBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "delivery": {
      "$ref": "#/$defs/deliveryBlock"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "summary": {
      "$ref": "#/$defs/indexSummary"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/indexEntry"
      }
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableWorldVerdict": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed",
        null
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shelfBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "deliveryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biography_summaries",
        "output_root",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "biography_summaries": {
          "allOf": [
            {
              "$ref": "#/$defs/stringArray"
            }
          ],
          "minItems": 1
        },
        "output_root": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "indexSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biography_count",
        "unique_world_count",
        "ok_count",
        "fail_count",
        "compare_attached_count",
        "not_attached_count",
        "standing_count",
        "improved_count",
        "drifted_count",
        "collapsed_count"
      ],
      "properties": {
        "biography_count": {
          "type": "integer",
          "minimum": 1
        },
        "unique_world_count": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_attached_count": {
          "type": "integer",
          "minimum": 0
        },
        "not_attached_count": {
          "type": "integer",
          "minimum": 0
        },
        "standing_count": {
          "type": "integer",
          "minimum": 0
        },
        "improved_count": {
          "type": "integer",
          "minimum": 0
        },
        "drifted_count": {
          "type": "integer",
          "minimum": 0
        },
        "collapsed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "indexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "world_name",
        "world_title",
        "board",
        "active_facets",
        "result",
        "world_verdict",
        "compare_attached",
        "identity",
        "thesis",
        "evidence_path",
        "next_questions",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "runtime_evidence_summary",
        "witness_bundle_summary",
        "world_compare_summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "world_name": {
          "type": "string"
        },
        "world_title": {
          "type": "string"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "world_verdict": {
          "$ref": "#/$defs/nullableWorldVerdict"
        },
        "compare_attached": {
          "type": "boolean"
        },
        "identity": {
          "type": "string"
        },
        "thesis": {
          "type": "string"
        },
        "evidence_path": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "runtime_evidence_summary": {
          "type": "string"
        },
        "witness_bundle_summary": {
          "type": "string"
        },
        "world_compare_summary": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_questions",
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "core_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
