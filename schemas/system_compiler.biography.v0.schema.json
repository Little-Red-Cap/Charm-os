{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.biography.v0.schema.json",
  "title": "system_compiler.biography/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "profile",
    "world_verdict",
    "world",
    "biography",
    "delivery",
    "artifact_context",
    "runtime_evidence",
    "witness_bundle",
    "world_compare",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.biography/v0"
    },
    "kind": {
      "const": "system_compiler.biography"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "profile": {
      "type": "string"
    },
    "world_verdict": {
      "$ref": "#/$defs/nullableWorldVerdict"
    },
    "world": {
      "$ref": "#/$defs/worldView"
    },
    "biography": {
      "$ref": "#/$defs/biographyBlock"
    },
    "delivery": {
      "$ref": "#/$defs/deliveryBlock"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "runtime_evidence": {
      "$ref": "#/$defs/runtimeEvidenceView"
    },
    "witness_bundle": {
      "$ref": "#/$defs/witnessBundleView"
    },
    "world_compare": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/worldCompareView"
          }
        }
      ]
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nullableWorldVerdict": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed",
        null
      ]
    },
    "subjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "worldView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "summary",
        "subject",
        "first_class_terms",
        "core_questions",
        "compare_questions",
        "contract_refs"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/subjectSummary"
        },
        "first_class_terms": {
          "$ref": "#/$defs/stringArray"
        },
        "core_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "contract_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "biographyBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "thesis",
        "evidence_path",
        "next_questions"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "thesis": {
          "type": "string"
        },
        "evidence_path": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "deliveryBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_world_path",
        "runtime_evidence_summary",
        "runtime_evidence_report_markdown_path",
        "runtime_evidence_check_text_path",
        "witness_bundle_summary",
        "witness_bundle_report_markdown_path",
        "witness_bundle_check_text_path",
        "baseline_witness_summary",
        "world_compare_summary",
        "world_compare_report_markdown_path",
        "world_compare_check_text_path"
      ],
      "properties": {
        "canonical_world_path": {
          "$ref": "#/$defs/nullableString"
        },
        "runtime_evidence_summary": {
          "type": "string"
        },
        "runtime_evidence_report_markdown_path": {
          "type": "string"
        },
        "runtime_evidence_check_text_path": {
          "type": "string"
        },
        "witness_bundle_summary": {
          "type": "string"
        },
        "witness_bundle_report_markdown_path": {
          "type": "string"
        },
        "witness_bundle_check_text_path": {
          "type": "string"
        },
        "baseline_witness_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "world_compare_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "world_compare_report_markdown_path": {
          "$ref": "#/$defs/nullableString"
        },
        "world_compare_check_text_path": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "runtimeHostView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_ok_count",
        "cold_fail_count",
        "cold_other_count",
        "warm_ok_count",
        "warm_fail_count",
        "warm_other_count",
        "warm_regressions",
        "warm_improvements"
      ],
      "properties": {
        "cold_ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "cold_fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "cold_other_count": {
          "type": "integer",
          "minimum": 0
        },
        "warm_ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "warm_fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "warm_other_count": {
          "type": "integer",
          "minimum": 0
        },
        "warm_regressions": {
          "type": "integer",
          "minimum": 0
        },
        "warm_improvements": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtimeQemuView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "case_count",
        "completed_case_count",
        "ok_count",
        "fail_count",
        "other_count",
        "biography_identity",
        "witness_conclusion"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "other_count": {
          "type": "integer",
          "minimum": 0
        },
        "biography_identity": {
          "$ref": "#/$defs/nullableString"
        },
        "witness_conclusion": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "runtimeEvidenceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "host",
        "qemu"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/runtimeHostView"
        },
        "qemu": {
          "$ref": "#/$defs/runtimeQemuView"
        }
      }
    },
    "witnessBundleView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "entry_count",
        "ok_count",
        "missing_count",
        "fail_count",
        "required_missing_count"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_missing_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worldCompareView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "world_verdict",
        "regression_count",
        "improvement_count",
        "required_regression_count",
        "collapse_surface_changed",
        "affected_layers",
        "affected_focus"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "world_verdict": {
          "type": "string",
          "enum": [
            "standing",
            "improved",
            "drifted",
            "collapsed"
          ]
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "improvement_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "collapse_surface_changed": {
          "type": "boolean"
        },
        "affected_layers": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_focus": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_questions",
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "core_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
