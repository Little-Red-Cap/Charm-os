      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_case_count",
        "candidate_case_count",
        "changed_case_count",
        "added_case_count",
        "removed_case_count",
        "unchanged_case_count",
        "regression_count",
        "improvement_count",
        "neutral_change_count",
        "projection_regression_count",
        "projection_improvement_count",
        "compare_context_lost_count",
        "compare_context_gained_count",
        "inspector_readiness_changed_count",
