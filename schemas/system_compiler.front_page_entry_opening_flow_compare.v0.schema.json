        "actual_opener_count_change": {
          "$ref": "#/$defs/countChange"
        },
        "available_projection_count_change": {
          "$ref": "#/$defs/countChange"
        },
        "compare_context_count_change": {
          "$ref": "#/$defs/countChange"
