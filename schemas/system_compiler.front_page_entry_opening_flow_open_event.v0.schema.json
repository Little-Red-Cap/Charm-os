      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "facade_kind",
        "primary_surface_role",
        "primary_summary_path",
        "primary_report_markdown_path",
        "primary_check_text_path"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "projected",
            "blocked"
          ]
        },
        "facade_kind": {
          "type": "string"
        },
        "primary_surface_role": {
          "type": "string"
        },
        "primary_summary_path": {
          "type": "string"
        },
        "primary_report_markdown_path": {
          "type": "string"
        },
        "primary_check_text_path": {
          "type": "string"
        }
      }
    },
    "witnessRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_role",
        "status",
        "grade",
        "basis",
        "accepted",
        "summary"
      ],
      "properties": {
        "semantic_role": {
          "const": "opening_judgment_carrier"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "accepted_with_drift",
            "blocked"
          ]
        },
        "grade": {
          "type": "string",
          "enum": [
            "described",
            "compared"
          ]
        },
        "basis": {
          "$ref": "#/$defs/stringArray"
        },
        "accepted": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "explanationView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "status",
        "why_opened",
        "chosen_consumer",
        "plan_actions",
        "compare_result",
        "witness_refs",
        "text_lines"
      ],
      "properties": {
        "view_kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "why_opened": {
          "type": "string"
        },
        "chosen_consumer": {
          "type": "string"
        },
        "plan_actions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_result": {
          "type": "string"
        },
        "witness_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "text_lines": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "typedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "target_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inspect_action_compare",
            "attach_action_compare",
            "inspect_rejected_consumers"
          ]
        },
        "summary": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_event_questions",
        "next_questions",
        "typed_next_questions"
      ],
      "properties": {
        "open_event_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "typed_next_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typedQuestion"
          }
        }
      }
    }
  }
}
