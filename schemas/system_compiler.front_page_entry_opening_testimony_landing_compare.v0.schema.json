    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_testimony_landing_compare": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "landing_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landingProvenance"
      }
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "landing_verdict": {
      "type": "string",
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed"
      ]
    },
    "landing_status": {
      "$ref": "#/$defs/landingStatus"
    },
    "opening_identity_changes": {
      "$ref": "#/$defs/changeBlock"
    },
    "landing_decision_changes": {
      "$ref": "#/$defs/changeBlock"
    },
    "testimony_preview_changes": {
      "$ref": "#/$defs/changeBlock"
    },
    "artifact_target_changes": {
      "$ref": "#/$defs/changeBlock"
    },
    "next_question_changes": {
      "$ref": "#/$defs/changeBlock"
    },
    "change_summary": {
      "$ref": "#/$defs/changeSummary"
    },
    "landing_regression_surface": {
      "$ref": "#/$defs/regressionSurface"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
