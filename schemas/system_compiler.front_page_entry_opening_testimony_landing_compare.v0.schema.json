      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "result_changed",
        "landing_status_changed",
        "landing_collapsed",
        "landing_recovered",
        "selected_entry_changed",
        "selected_tab_changed",
        "selected_role_changed",
        "source_open_event_changed",
        "source_judgment_changed",
        "source_witness_status_changed",
