    "openAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "status",
        "selected_tab_id",
        "selected_tab_title",
        "selected_route_id",
        "selected_surface_id",
        "selected_role",
        "query_kind",
        "query_scope",
        "selection_rule",
        "compare_expected",
        "followup_query_kinds",
        "opening_reason",
        "target_summary_schema",
        "target_summary_kind",
        "target_summary_path",
        "target_report_markdown_path",
        "target_check_text_path",
        "rationale",
        "compare_context_available",
        "blockers"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "action_kind": {
          "type": "string",
          "enum": [
            "open_explain_entry"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "selected_tab_id": {
          "type": "string"
        },
        "selected_tab_title": {
          "type": "string"
        },
        "selected_route_id": {
          "type": "string"
        },
        "selected_surface_id": {
          "type": "string"
        },
        "selected_role": {
          "type": "string"
        },
        "query_kind": {
          "type": "string",
          "enum": [
            "default_overview",
            "bringup_evidence",
            "resource_summary",
            "cap_list"
          ]
        },
        "query_scope": {
          "type": "string",
          "enum": [
            "report",
            "artifact_root"
          ]
        },
        "selection_rule": {
          "type": "string",
          "enum": [
            "single_report",
            "artifact_root_full",
            "artifact_root_or_subset"
          ]
        },
        "compare_expected": {
          "type": "boolean"
        },
        "followup_query_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "opening_reason": {
          "$ref": "#/$defs/openingReason"
        },
        "target_summary_schema": {
          "type": "string"
        },
        "target_summary_kind": {
          "type": "string"
        },
        "target_summary_path": {
          "type": "string"
        },
        "target_report_markdown_path": {
          "type": "string"
        },
        "target_check_text_path": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "compare_context_available": {
          "type": "boolean"
        },
        "blockers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "inspectorInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_path",
        "ready",
        "mode",
        "query_kind",
        "output_format",
        "arguments",
        "powershell_command",
        "blockers"
      ],
      "properties": {
        "script_path": {
          "type": "string"
