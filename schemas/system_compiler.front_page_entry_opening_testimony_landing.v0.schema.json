{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_testimony_landing.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_testimony_landing/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_testimony_landing",
    "front_page",
    "artifact_context",
    "source_witness_ref",
    "opening_identity",
    "landing_decision",
    "testimony_preview",
    "artifact_targets",
    "next_questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_testimony_landing/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_testimony_landing"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_testimony_landing": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "source_witness_ref": {
      "$ref": "#/$defs/sourceWitnessRef"
    },
    "opening_identity": {
      "$ref": "#/$defs/openingIdentity"
    },
    "landing_decision": {
      "$ref": "#/$defs/landingDecision"
    },
    "testimony_preview": {
      "$ref": "#/$defs/testimonyPreview"
    },
    "artifact_targets": {
      "$ref": "#/$defs/artifactTargets"
    },
    "next_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/typedQuestion"
      }
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_witness_summary_path",
        "source_witness_report_markdown_path",
        "source_witness_check_text_path",
        "output_root",
        "landing_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_witness_summary_path": {
          "type": "string"
        },
        "source_witness_report_markdown_path": {
          "type": "string"
        },
        "source_witness_check_text_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "landing_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "sourceWitnessRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openingIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_event_id",
        "open_event_status",
        "open_event_result",
        "reason_kind",
        "reason_summary",
        "source_judgment_status",
        "source_judgment_grade",
        "source_witness_id",
        "source_witness_status",
        "source_open_event_summary_path"
      ],
      "properties": {
        "open_event_id": {
          "type": "string"
        },
        "open_event_status": {
          "type": "string",
          "enum": [
            "",
            "accepted",
            "accepted_with_drift",
            "blocked"
          ]
        },
        "open_event_result": {
          "type": "string",
          "enum": [
            "",
            "ok",
            "fail"
          ]
        },
        "reason_kind": {
          "type": "string"
        },
        "reason_summary": {
          "type": "string"
        },
        "source_judgment_status": {
          "type": "string",
          "enum": [
            "",
            "accepted",
            "accepted_with_drift",
            "blocked"
          ]
        },
        "source_judgment_grade": {
          "type": "string",
          "enum": [
            "",
            "described",
            "compared"
          ]
        },
        "source_witness_id": {
          "type": "string"
        },
        "source_witness_status": {
          "type": "string",
          "enum": [
            "",
            "ok",
            "fail"
          ]
        },
        "source_open_event_summary_path": {
          "type": "string"
        }
      }
    },
    "openingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "source_summary_path"
      ],
      "properties": {
        "kind": {
          "const": "open_event_witness_testimony"
        },
        "summary": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        }
      }
    },
    "landingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_entry_id",
        "selected_tab_id",
        "selected_role",
        "opening_reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "selected_entry_id": {
          "const": "open-event-witness"
        },
        "selected_tab_id": {
          "const": "opening_testimony"
        },
        "selected_role": {
          "const": "opening_testimony"
        },
        "opening_reason": {
          "$ref": "#/$defs/openingReason"
        }
      }
    },
    "testimonyPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "source_judgment_summary",
        "summary_lines",
        "explanation_text_lines",
        "observation_lines",
        "summary_line_count",
        "explanation_line_count",
        "observation_count"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "source_judgment_summary": {
          "type": "string"
        },
        "summary_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "explanation_text_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "observation_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "summary_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "explanation_line_count": {
          "type": "integer",
          "minimum": 0
        },
        "observation_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "artifactTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_refs",
        "witness_artifact_refs",
        "evidence_ref_count",
        "witness_artifact_ref_count"
      ],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "witness_artifact_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        },
        "witness_artifact_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "typedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "target_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inspect_open_event",
            "inspect_evidence_refs",
            "compare_open_event_witness"
          ]
        },
        "summary": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        }
      }
    }
  }
}
