        "candidate_landing_status": {
          "type": "string"
        },
        "baseline_open_event_id": {
          "type": "string"
        },
        "candidate_open_event_id": {
          "type": "string"
        },
        "baseline_source_judgment_status": {
          "type": "string"
        },
        "candidate_source_judgment_status": {
          "type": "string"
        },
        "baseline_source_witness_status": {
          "type": "string"
        },
        "candidate_source_witness_status": {
          "type": "string"
        },
        "baseline_selected_entry_id": {
          "type": "string"
        },
        "candidate_selected_entry_id": {
          "type": "string"
        },
        "baseline_selected_tab_id": {
          "type": "string"
        },
        "candidate_selected_tab_id": {
          "type": "string"
        },
        "baseline_selected_role": {
          "type": "string"
        },
        "candidate_selected_role": {
          "type": "string"
        }
      }
    },
    "fieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "changed"
      ],
      "properties": {
        "baseline": {},
        "candidate": {},
        "changed": {
          "type": "boolean"
        }
      }
    },
    "changeBlock": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/fieldChange"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "boolean"
          }
        ]
      },
      "required": [
        "changed_fields",
        "changed_field_count",
        "changed"
      ],
      "properties": {
        "changed_fields": {
          "$ref": "#/$defs/stringArray"
        },
        "changed_field_count": {
          "type": "integer",
          "minimum": 0
