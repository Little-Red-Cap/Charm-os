        "id": {
          "type": "string"
        },
        "landing_role": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_report_markdown_path": {
          "type": "string"
        },
        "source_check_text_path": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "landing_status": {
          "type": "string"
        },
        "open_event_id": {
          "type": "string"
        },
        "source_judgment_status": {
          "type": "string"
        },
        "source_witness_status": {
          "type": "string"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_opening_testimony_landing_summary_path",
        "candidate_opening_testimony_landing_summary_path",
