        "baseline_actual_opener_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_actual_opener_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_available_projection_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_available_projection_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_compare_context_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_compare_context_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_inspector_ready_count": {
          "type": "integer",
          "minimum": 0
