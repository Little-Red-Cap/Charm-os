    "capabilityFlagMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_biography",
        "counterfactual_verdict",
        "grouped_review",
        "supporting_evidence",
        "supporting_testimony",
        "shelf_compare",
        "candidate_shelf",
        "baseline_shelf",
        "route_provenance"
      ],
      "properties": {
        "delivery_biography": {
          "type": "boolean"
        },
        "counterfactual_verdict": {
          "type": "boolean"
        },
        "grouped_review": {
          "type": "boolean"
        },
        "supporting_evidence": {
          "type": "boolean"
        },
        "supporting_testimony": {
          "type": "boolean"
        },
        "shelf_compare": {
          "type": "boolean"
        },
        "candidate_shelf": {
          "type": "boolean"
        },
        "baseline_shelf": {
          "type": "boolean"
        },
        "route_provenance": {
          "type": "boolean"
        }
      }
    },
    "capabilityCountMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_biography",
        "counterfactual_verdict",
        "grouped_review",
        "supporting_evidence",
        "supporting_testimony",
        "shelf_compare",
        "candidate_shelf",
        "baseline_shelf",
        "route_provenance"
      ],
      "properties": {
        "delivery_biography": {
          "type": "integer",
          "minimum": 0
        },
        "counterfactual_verdict": {
          "type": "integer",
          "minimum": 0
        },
        "grouped_review": {
          "type": "integer",
          "minimum": 0
        },
        "supporting_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "supporting_testimony": {
          "type": "integer",
          "minimum": 0
        },
        "shelf_compare": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_shelf": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_shelf": {
          "type": "integer",
          "minimum": 0
        },
        "route_provenance": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "depth",
        "surface_id",
        "label",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "revisit",
        "cycle",
        "expanded",
        "route_provenance_count",
        "supporting_surface_count"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "surface_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "revisit": {
          "type": "boolean"
        },
        "cycle": {
          "type": "boolean"
        },
        "expanded": {
          "type": "boolean"
        },
        "route_provenance_count": {
          "type": "integer",
          "minimum": 0
        },
        "supporting_surface_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preferredEntryMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delivery_biography",
        "counterfactual_verdict",
        "grouped_review",
        "supporting_evidence",
        "supporting_testimony",
        "shelf_compare",
        "candidate_shelf",
        "baseline_shelf",
        "route_provenance"
      ],
      "properties": {
        "delivery_biography": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "counterfactual_verdict": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "grouped_review": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "supporting_evidence": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "supporting_testimony": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "shelf_compare": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "candidate_shelf": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "baseline_shelf": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        },
        "route_provenance": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/entryRef"
              }
            }
          ]
        }
      }
    },
    "capabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_capability_ids",
        "missing_capability_ids",
        "capability_flags",
        "capability_counts",
        "preferred_entries"
      ],
      "properties": {
        "available_capability_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "missing_capability_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "capability_flags": {
          "$ref": "#/$defs/capabilityFlagMap"
        },
        "capability_counts": {
          "$ref": "#/$defs/capabilityCountMap"
        },
        "preferred_entries": {
          "$ref": "#/$defs/preferredEntryMap"
        }
      }
    },
    "provenanceHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_route_id",
        "owner_surface_id",
        "owner_surface_role",
        "owner_depth",
        "provenance_id",
        "provenance_route_kind",
        "source_summary_schema",
        "source_summary_path",
        "source_front_page_summary_path",
        "available_supporting_surface_ids"
      ],
      "properties": {
        "owner_route_id": {
          "type": "string"
        },
        "owner_surface_id": {
          "type": "string"
        },
        "owner_surface_role": {
          "type": "string"
        },
        "owner_depth": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_id": {
          "type": "string"
        },
        "provenance_route_kind": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_front_page_summary_path": {
          "type": "string"
        },
        "available_supporting_surface_ids": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance_route_kind": {
                "const": "artifact_report_index"
              }
            }
          },
          "then": {
            "properties": {
              "source_summary_schema": {
                "const": "system_compiler.artifact_report_index/v0"
              },
              "source_front_page_summary_path": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
