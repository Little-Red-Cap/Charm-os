module;
#include <cstddef>
#include <cstdint>

export module charm.core.soa_pool_caps;

export import charm.core.handle;

namespace {
#if defined(CHARM_VIVID_SOA_MAX_NODES)
constexpr std::size_t kDefaultPoolCap = CHARM_VIVID_SOA_MAX_NODES;
#else
constexpr std::size_t kDefaultPoolCap = 256;
#endif
constexpr std::size_t kDefaultTextArenaBytes = 8192;
} // namespace

constexpr std::size_t kPoolCapLabel = @SOA_POOL_CAP_LABEL@;
constexpr std::size_t kPoolCapButton = @SOA_POOL_CAP_BUTTON@;
constexpr std::size_t kPoolCapImage = @SOA_POOL_CAP_IMAGE@;
constexpr std::size_t kPoolCapTextInput = @SOA_POOL_CAP_TEXT_INPUT@;
constexpr std::size_t kPoolCapTextArea = @SOA_POOL_CAP_TEXT_AREA@;
constexpr std::size_t kPoolCapNumberInput = @SOA_POOL_CAP_NUMBER_INPUT@;
constexpr std::size_t kPoolCapSegmentedControl = @SOA_POOL_CAP_SEGMENTED_CONTROL@;
constexpr std::size_t kPoolCapToggleGroup = @SOA_POOL_CAP_TOGGLE_GROUP@;
constexpr std::size_t kPoolCapCheckbox = @SOA_POOL_CAP_CHECKBOX@;
constexpr std::size_t kPoolCapRadio = @SOA_POOL_CAP_RADIO@;
constexpr std::size_t kPoolCapListItem = @SOA_POOL_CAP_LIST_ITEM@;
constexpr std::size_t kPoolCapTextList = @SOA_POOL_CAP_TEXT_LIST@;
constexpr std::size_t kPoolCapListView = @SOA_POOL_CAP_LIST_VIEW@;
constexpr std::size_t kPoolCapTableView = @SOA_POOL_CAP_TABLE_VIEW@;
constexpr std::size_t kPoolCapTreeView = @SOA_POOL_CAP_TREE_VIEW@;
constexpr std::size_t kPoolCapSwitch = @SOA_POOL_CAP_SWITCH@;
constexpr std::size_t kPoolCapSlider = @SOA_POOL_CAP_SLIDER@;
constexpr std::size_t kPoolCapProgress = @SOA_POOL_CAP_PROGRESS@;
constexpr std::size_t kPoolCapScrollbar = @SOA_POOL_CAP_SCROLLBAR@;
constexpr std::size_t kPoolCapList = @SOA_POOL_CAP_LIST@;
constexpr std::size_t kPoolCapScrollContainer = @SOA_POOL_CAP_SCROLL_CONTAINER@;
constexpr std::size_t kPoolCapSpinner = @SOA_POOL_CAP_SPINNER@;
constexpr std::size_t kSoaTextArenaBytes = @SOA_TEXT_ARENA_BYTES@;

static_assert(kPoolCapLabel > 0);
static_assert(kPoolCapButton > 0);
static_assert(kPoolCapImage > 0);
static_assert(kPoolCapTextInput > 0);
static_assert(kPoolCapTextArea > 0);
static_assert(kPoolCapNumberInput > 0);
static_assert(kPoolCapSegmentedControl > 0);
static_assert(kPoolCapToggleGroup > 0);
static_assert(kPoolCapCheckbox > 0);
static_assert(kPoolCapRadio > 0);
static_assert(kPoolCapListItem > 0);
static_assert(kPoolCapTextList > 0);
static_assert(kPoolCapListView > 0);
static_assert(kPoolCapTableView > 0);
static_assert(kPoolCapTreeView > 0);
static_assert(kPoolCapSwitch > 0);
static_assert(kPoolCapSlider > 0);
static_assert(kPoolCapProgress > 0);
static_assert(kPoolCapScrollbar > 0);
static_assert(kPoolCapList > 0);
static_assert(kPoolCapScrollContainer > 0);
static_assert(kPoolCapSpinner > 0);
static_assert(kSoaTextArenaBytes > 0);
static_assert(kSoaTextArenaBytes <= 0xFFFF);

export constexpr std::size_t soa_text_arena_bytes() noexcept {
    return kSoaTextArenaBytes;
}

export constexpr std::size_t pool_cap(WidgetKind kind) noexcept {
    if (kind == WidgetKind::Label) return kPoolCapLabel;
    if (kind == WidgetKind::Button) return kPoolCapButton;
    if (kind == WidgetKind::Image) return kPoolCapImage;
    if (kind == WidgetKind::TextInput) return kPoolCapTextInput;
    if (kind == WidgetKind::TextArea) return kPoolCapTextArea;
    if (kind == WidgetKind::NumberInput) return kPoolCapNumberInput;
    if (kind == WidgetKind::SegmentedControl) return kPoolCapSegmentedControl;
    if (kind == WidgetKind::ToggleGroup) return kPoolCapToggleGroup;
    if (kind == WidgetKind::Checkbox) return kPoolCapCheckbox;
    if (kind == WidgetKind::Radio) return kPoolCapRadio;
    if (kind == WidgetKind::ListItem) return kPoolCapListItem;
    if (kind == WidgetKind::TextList) return kPoolCapTextList;
    if (kind == WidgetKind::ListView) return kPoolCapListView;
    if (kind == WidgetKind::TableView) return kPoolCapTableView;
    if (kind == WidgetKind::TreeView) return kPoolCapTreeView;
    if (kind == WidgetKind::Switch) return kPoolCapSwitch;
    if (kind == WidgetKind::Slider) return kPoolCapSlider;
    if (kind == WidgetKind::Progress) return kPoolCapProgress;
    if (kind == WidgetKind::ScrollBar) return kPoolCapScrollbar;
    if (kind == WidgetKind::List) return kPoolCapList;
    if (kind == WidgetKind::ScrollContainer) return kPoolCapScrollContainer;
    if (kind == WidgetKind::Spinner) return kPoolCapSpinner;
    return 0;
}
