module;

#include <cstddef>
#include <cstdint>

export module player.stm32h7.app_config.generated;

export namespace player::stm32h7::app::config {
    enum class Profile : std::uint8_t {
        legacy_main = 0,
        usb_as = 1,
        usb_audio = 2,
        usb_self_cdc = 3,
        usb_self_msc = 4,
        usb_storage = 5,
    };

    struct IdentityConfig {
        const char* product;
        const char* platform;
        const char* board;
        const char* scenario;
        const char* profile_name;
        Profile profile;
        bool usb_use_composite;
    };

    struct UartConfig {
        std::size_t rx_cap;
        std::size_t tx_cap;
    };

    struct BringupConfig {
        bool key_select;
        bool wait_key;
        bool enable_audio;
        bool enable_sdmmc_init;
        bool enable_usb_msc;
        bool use_st_usb_stack;
        bool enable_usb_audio;
        bool use_usb_audio_on_boot;
        bool enable_display;
        bool use_out_logger_early;
        bool use_dma_console;
        bool fmc_init_on_boot;
        bool sdram_selftest_on_boot;
        bool sdram_selftest_in_bringup;
        bool enable_i2s_init;
        bool enable_spi5_init;
    };

    struct DebugConfig {
        bool stop_after_bringup;
        bool stop_after_channel;
        bool stop_after_fs;
        bool dump_root;
    };

    struct EncoderTestConfig {
        bool enable_on_boot;
        std::uint32_t duration_ms;
    };

    struct ProductConfig {
        IdentityConfig identity;
    };

    struct BoardDefaultsConfig {
        UartConfig uart;
        BringupConfig bringup;
    };

    struct AppBehaviorConfig {
        DebugConfig debug;
        EncoderTestConfig encoder_test;
    };

    struct AppConfig {
        ProductConfig product;
        BoardDefaultsConfig board;
        AppBehaviorConfig app;
    };

    inline constexpr AppConfig kConfig{
        ProductConfig{
            IdentityConfig{
                "@PLAYER_PRODUCT@",
                "@PLAYER_PLATFORM@",
                "@PLAYER_BOARD@",
                "@PLAYER_SCENARIO@",
                "@PLAYER_PROFILE@",
                Profile::@PLAYER_APP_PROFILE_ENUM@,
                @PLAYER_APP_USB_USE_COMPOSITE@
            }
        },
        BoardDefaultsConfig{
            UartConfig{
                @PLAYER_APP_RX_CAP@,
                @PLAYER_APP_TX_CAP@
            },
            BringupConfig{
                @PLAYER_APP_BRINGUP_KEY_SELECT@,
                @PLAYER_APP_BRINGUP_WAIT_KEY@,
                @PLAYER_APP_ENABLE_AUDIO@,
                @PLAYER_APP_ENABLE_SDMMC_INIT@,
                @PLAYER_APP_ENABLE_USB_MSC@,
                @PLAYER_APP_USE_ST_USB_STACK@,
                @PLAYER_APP_ENABLE_USB_AUDIO@,
                @PLAYER_APP_USE_USB_AUDIO_ON_BOOT@,
                @PLAYER_APP_ENABLE_DISPLAY@,
                @PLAYER_APP_USE_OUT_LOGGER_EARLY@,
                @PLAYER_APP_USE_DMA_CONSOLE@,
                @PLAYER_APP_FMC_INIT_ON_BOOT@,
                @PLAYER_APP_SDRAM_SELFTEST_ON_BOOT@,
                @PLAYER_APP_SDRAM_SELFTEST_IN_BRINGUP@,
                @PLAYER_APP_ENABLE_I2S_INIT@,
                @PLAYER_APP_ENABLE_SPI5_INIT@
            }
        },
        AppBehaviorConfig{
            DebugConfig{
                @PLAYER_APP_DEBUG_STOP_AFTER_BRINGUP@,
                @PLAYER_APP_DEBUG_STOP_AFTER_CHANNEL@,
                @PLAYER_APP_DEBUG_STOP_AFTER_FS@,
                @PLAYER_APP_DEBUG_DUMP_ROOT@
            },
            EncoderTestConfig{
                @PLAYER_APP_ENCODER_TEST_ON_BOOT@,
                @PLAYER_APP_ENCODER_TEST_MS@
            }
        }
    };

    inline constexpr ProductConfig kProduct = kConfig.product;
    inline constexpr BoardDefaultsConfig kBoard = kConfig.board;
    inline constexpr AppBehaviorConfig kApp = kConfig.app;

    [[deprecated("改用 kProduct.identity")]]
    inline constexpr IdentityConfig kIdentity = kConfig.product.identity;
    [[deprecated("改用 kBoard.uart")]]
    inline constexpr UartConfig kUart = kConfig.board.uart;
    [[deprecated("改用 kBoard.bringup")]]
    inline constexpr BringupConfig kBringup = kConfig.board.bringup;
    [[deprecated("改用 kApp.debug")]]
    inline constexpr DebugConfig kDebug = kConfig.app.debug;
    [[deprecated("改用 kApp.encoder_test")]]
    inline constexpr EncoderTestConfig kEncoderTest = kConfig.app.encoder_test;

    [[deprecated("改用 kBoard.uart.rx_cap")]]
    inline constexpr std::size_t kRxCap = kConfig.board.uart.rx_cap;
    [[deprecated("改用 kBoard.uart.tx_cap")]]
    inline constexpr std::size_t kTxCap = kConfig.board.uart.tx_cap;

    [[deprecated("改用 kBoard.bringup.key_select")]]
    inline constexpr bool kBringupKeySelect = kConfig.board.bringup.key_select;
    [[deprecated("改用 kBoard.bringup.wait_key")]]
    inline constexpr bool kBringupWaitKey = kConfig.board.bringup.wait_key;
    [[deprecated("改用 kBoard.bringup.enable_audio")]]
    inline constexpr bool kEnableAudio = kConfig.board.bringup.enable_audio;
    [[deprecated("改用 kBoard.bringup.enable_sdmmc_init")]]
    inline constexpr bool kEnableSdmmcInit = kConfig.board.bringup.enable_sdmmc_init;
    [[deprecated("改用 kBoard.bringup.enable_usb_msc")]]
    inline constexpr bool kEnableUsbMsc = kConfig.board.bringup.enable_usb_msc;
    [[deprecated("改用 kBoard.bringup.use_st_usb_stack")]]
    inline constexpr bool kUseStUsbStack = kConfig.board.bringup.use_st_usb_stack;
    [[deprecated("改用 kBoard.bringup.enable_usb_audio")]]
    inline constexpr bool kEnableUsbAudio = kConfig.board.bringup.enable_usb_audio;
    [[deprecated("改用 kBoard.bringup.use_usb_audio_on_boot")]]
    inline constexpr bool kUseUsbAudioOnBoot = kConfig.board.bringup.use_usb_audio_on_boot;
    [[deprecated("改用 kBoard.bringup.enable_display")]]
    inline constexpr bool kEnableDisplay = kConfig.board.bringup.enable_display;
    [[deprecated("改用 kBoard.bringup.use_out_logger_early")]]
    inline constexpr bool kUseOutLoggerEarly = kConfig.board.bringup.use_out_logger_early;
    [[deprecated("改用 kBoard.bringup.use_dma_console")]]
    inline constexpr bool kUseDmaConsole = kConfig.board.bringup.use_dma_console;
    [[deprecated("改用 kBoard.bringup.fmc_init_on_boot")]]
    inline constexpr bool kFmcInitOnBoot = kConfig.board.bringup.fmc_init_on_boot;
    [[deprecated("改用 kBoard.bringup.sdram_selftest_on_boot")]]
    inline constexpr bool kSdramSelftestOnBoot = kConfig.board.bringup.sdram_selftest_on_boot;
    [[deprecated("改用 kBoard.bringup.sdram_selftest_in_bringup")]]
    inline constexpr bool kSdramSelftestInBringup = kConfig.board.bringup.sdram_selftest_in_bringup;
    [[deprecated("改用 kBoard.bringup.enable_i2s_init")]]
    inline constexpr bool kEnableI2sInit = kConfig.board.bringup.enable_i2s_init;
    [[deprecated("改用 kBoard.bringup.enable_spi5_init")]]
    inline constexpr bool kEnableSpi5Init = kConfig.board.bringup.enable_spi5_init;

    [[deprecated("改用 kApp.debug.stop_after_bringup")]]
    inline constexpr bool kDebugStopAfterBringup = kConfig.app.debug.stop_after_bringup;
    [[deprecated("改用 kApp.debug.stop_after_channel")]]
    inline constexpr bool kDebugStopAfterChannel = kConfig.app.debug.stop_after_channel;
    [[deprecated("改用 kApp.debug.stop_after_fs")]]
    inline constexpr bool kDebugStopAfterFs = kConfig.app.debug.stop_after_fs;
    [[deprecated("改用 kApp.debug.dump_root")]]
    inline constexpr bool kDebugDumpRoot = kConfig.app.debug.dump_root;

    [[deprecated("改用 kApp.encoder_test.enable_on_boot")]]
    inline constexpr bool kEncoderTestOnBoot = kConfig.app.encoder_test.enable_on_boot;
    [[deprecated("改用 kApp.encoder_test.duration_ms")]]
    inline constexpr std::uint32_t kEncoderTestMs = kConfig.app.encoder_test.duration_ms;

    static_assert(kBoard.uart.rx_cap > 0);
    static_assert(kBoard.uart.tx_cap > 0);
    static_assert(kApp.encoder_test.duration_ms > 0);
}
