{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_flow_open_event.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_flow_open_event/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_flow_open_event",
    "front_page",
    "artifact_context",
    "open_event",
    "consumer_decision",
    "plan",
    "action_records",
    "compare_summary",
    "workspace_facade",
    "witness_refs",
    "judgment",
    "explanation_view",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_flow_open_event/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_flow_open_event"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_flow_open_event": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "open_event": {
      "$ref": "#/$defs/openEvent"
    },
    "consumer_decision": {
      "$ref": "#/$defs/consumerDecision"
    },
    "plan": {
      "$ref": "#/$defs/planSummary"
    },
    "action_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actionRecord"
      }
    },
    "compare_summary": {
      "$ref": "#/$defs/compareSummary"
    },
    "workspace_facade": {
      "$ref": "#/$defs/workspaceFacade"
    },
    "witness_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/witnessRef"
      }
    },
    "judgment": {
      "$ref": "#/$defs/judgment"
    },
    "explanation_view": {
      "$ref": "#/$defs/explanationView"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_action_summary_path",
        "source_action_compare_summary_path",
        "output_root",
        "open_event_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_action_summary_path": {
          "type": "string"
        },
        "source_action_compare_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "open_event_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "source_summary_path",
        "drift_changed",
        "drift_verdict"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "drift_changed": {
          "type": "boolean"
        },
        "drift_verdict": {
          "type": "string"
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_schema",
        "summary_kind",
        "summary_path",
        "opener_summary_path",
        "opener_report_markdown_path",
        "opener_check_text_path"
      ],
      "properties": {
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "opener_summary_path": {
          "type": "string"
        },
        "opener_report_markdown_path": {
          "type": "string"
        },
        "opener_check_text_path": {
          "type": "string"
        }
      }
    },
    "openEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_event_id",
        "status",
        "reason",
        "source_artifact"
      ],
      "properties": {
        "open_event_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "accepted_with_drift",
            "blocked"
          ]
        },
        "reason": {
          "$ref": "#/$defs/openingReason"
        },
        "source_artifact": {
          "$ref": "#/$defs/sourceArtifact"
        }
      }
    },
    "selectedConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "selected_action_id",
        "entry_name",
        "selected_role",
        "query_kind",
        "query_scope",
        "operation",
        "projection_kind",
        "chosen_by"
