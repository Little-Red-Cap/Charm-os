          "enum": [
            "added",
            "removed",
            "changed"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "regression",
            "improvement",
            "neutral"
          ]
        },
        "baseline_summary_path": {
          "type": "string"
