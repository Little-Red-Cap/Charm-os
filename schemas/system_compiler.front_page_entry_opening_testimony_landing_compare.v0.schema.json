    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
