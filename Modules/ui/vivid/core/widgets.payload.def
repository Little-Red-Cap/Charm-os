#ifndef VIVID_WIDGET_PAYLOAD
#define VIVID_WIDGET_PAYLOAD(name, payload)
#endif

#define VIVID_PAYLOAD_KIND(name, member, stats_field, cap_kind) \
    VIVID_WIDGET_PAYLOAD(name, name)
#include "widgets.payload.kinds.def"
#undef VIVID_PAYLOAD_KIND

// Readonly text box reuses Label payload storage.
VIVID_WIDGET_PAYLOAD(TextBox, Label)
// IconList reuses ListView payload storage.
VIVID_WIDGET_PAYLOAD(IconList, ListView)
// ConsoleBox reuses TextList payload storage.
VIVID_WIDGET_PAYLOAD(ConsoleBox, TextList)
// MenuItem reuses ListItem payload storage.
VIVID_WIDGET_PAYLOAD(MenuItem, ListItem)
// IconButton reuses Button payload storage.
VIVID_WIDGET_PAYLOAD(IconButton, Button)
// ProgressWheel reuses Progress payload storage.
VIVID_WIDGET_PAYLOAD(ProgressWheel, Progress)
// ProgressBarSimple reuses Progress payload storage.
VIVID_WIDGET_PAYLOAD(ProgressBarSimple, Progress)
// ProgressBarRound reuses Progress payload storage.
VIVID_WIDGET_PAYLOAD(ProgressBarRound, Progress)
// ProgressFlowing reuses Progress payload storage.
VIVID_WIDGET_PAYLOAD(ProgressFlowing, Progress)
// TabView reuses SegmentedControl payload storage.
VIVID_WIDGET_PAYLOAD(TabView, SegmentedControl)
