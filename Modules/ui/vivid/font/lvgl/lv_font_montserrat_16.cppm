};

export constexpr Font font_montserrat_16 = {
    .table = glyph_table,
    .ranges = glyph_ranges,
    .fallback_glyph = &glyph_table[31],
    .line_height = 22,
    .baseline = 17
};
static_assert(validate_font(font_montserrat_16));
