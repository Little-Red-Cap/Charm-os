{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/minimal_kernel.kernel_runtime_session.v0.schema.json",
  "title": "minimal_kernel.kernel_runtime_session/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at",
    "session_id",
    "world",
    "subject",
    "semantic_witness",
    "machine_witness",
    "runtime",
    "ledger",
    "verdict",
    "failures",
    "artifact_paths",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "minimal_kernel.kernel_runtime_session/v0"
    },
    "kind": {
      "const": "minimal_kernel.kernel_runtime_session"
    },
    "generated_at": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "world": {
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "semantic_witness": {
      "$ref": "#/$defs/semanticWitness"
    },
    "machine_witness": {
      "$ref": "#/$defs/machineWitness"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeFacts"
    },
    "ledger": {
      "$ref": "#/$defs/ledger"
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure"
      }
    },
    "artifact_paths": {
      "$ref": "#/$defs/artifactPaths"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "standing",
        "degraded",
        "missing"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board",
        "profile",
        "leaf"
      ],
      "properties": {
        "board": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "leaf": {
          "type": "string"
        }
      }
    },
    "semanticWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "status",
        "contracts",
        "source_summary",
        "cold_summary",
        "warm_summary"
      ],
      "properties": {
        "host": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "contracts": {
          "$ref": "#/$defs/stringArray"
        },
        "source_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "cold_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "warm_summary": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "machineWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qemu",
        "status",
        "source_summary",
        "exception_ingress",
        "interrupt_ingress",
        "timer_ingress",
        "trap_ingress",
        "context_ingress",
        "runtime_loop",
        "standing_cases",
        "regressed_cases"
      ],
      "properties": {
        "qemu": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "exception_ingress": {
          "type": "boolean"
        },
        "interrupt_ingress": {
          "type": "boolean"
        },
        "timer_ingress": {
          "type": "boolean"
        },
        "trap_ingress": {
          "type": "boolean"
        },
        "context_ingress": {
          "type": "boolean"
        },
        "runtime_loop": {
          "type": "boolean"
        },
        "standing_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "regressed_cases": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "runtimeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "trap",
        "thread",
        "task_syscall",
        "handoff_continuity"
      ],
      "properties": {
        "tick": {
          "type": "boolean"
        },
        "trap": {
          "type": "boolean"
        },
        "thread": {
          "type": "boolean"
        },
        "task_syscall": {
          "type": "boolean"
        },
        "handoff_continuity": {
          "type": "boolean"
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_ledger",
        "runtime_ledger",
        "event_count"
      ],
      "properties": {
        "phase_ledger": {
          "$ref": "#/$defs/nullableString"
        },
        "runtime_ledger": {
          "type": "string"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_status",
        "failure_domain"
      ],
      "properties": {
        "session_status": {
          "type": "string",
          "enum": [
            "standing",
            "drifted",
            "collapsed"
          ]
        },
        "failure_domain": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "domain",
        "layer",
        "focus",
        "required",
        "phase",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "decode_failed",
            "unsupported_service",
            "unbound_adapter",
            "unbound_bridge",
            "writeback_failed",
            "missing_phase",
            "unexpected_phase",
            "timeout",
            "spurious_interrupt",
            "trap_not_observed",
            "tick_not_observed",
            "thread_not_resumed",
            "handoff_not_landed",
            "handoff_continuity_broken",
            "host_semantic_mismatch",
            "machine_witness_missing",
            "world_contract_missing"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "semantic",
            "machine",
            "runtime",
            "bundle",
            "world"
          ]
        },
        "layer": {
          "type": "string"
        },
        "focus": {
          "$ref": "#/$defs/stringArray"
        },
        "required": {
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/nullableString"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "artifactPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "runtime_ledger",
        "report",
        "check",
        "source_runtime_evidence"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "runtime_ledger": {
          "type": "string"
        },
        "report": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "source_runtime_evidence": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_evidence_summary",
        "canonical_world"
      ],
      "properties": {
        "runtime_evidence_summary": {
          "type": "string"
        },
        "canonical_world": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
