    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_flow_compare",
    "front_page",
    "flow_provenance",
    "artifact_context",
    "flow_verdict",
    "flow_status",
    "flow_changes",
    "opener_case_summary",
    "opener_case_changes",
    "flow_regression_surface",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_flow_compare/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_flow_compare"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_flow_compare": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "flow_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flowProvenanceEntry"
      }
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "flow_verdict": {
      "type": "string",
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed"
      ]
    },
    "flow_status": {
      "$ref": "#/$defs/flowStatus"
    },
    "flow_changes": {
      "$ref": "#/$defs/flowChanges"
    },
    "opener_case_summary": {
      "$ref": "#/$defs/openerCaseSummary"
    },
    "opener_case_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openerCaseChange"
      }
    },
    "flow_regression_surface": {
      "$ref": "#/$defs/flowRegressionSurface"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
