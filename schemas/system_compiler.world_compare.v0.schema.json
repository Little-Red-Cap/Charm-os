{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.world_compare.v0.schema.json",
  "title": "system_compiler.world_compare/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "world_verdict",
    "world",
    "artifact_context",
    "bundle_status",
    "world_changes",
    "contract_drift",
    "witness_summary",
    "witness_changes",
    "collapse_surface",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.world_compare/v0"
    },
    "kind": {
      "const": "system_compiler.world_compare"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "world_verdict": {
      "type": "string",
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed"
      ]
    },
    "world": {
      "$ref": "#/$defs/worldView"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "bundle_status": {
      "$ref": "#/$defs/bundleStatus"
    },
    "world_changes": {
      "$ref": "#/$defs/worldChanges"
    },
    "contract_drift": {
      "$ref": "#/$defs/contractDrift"
    },
    "witness_summary": {
      "$ref": "#/$defs/witnessSummary"
    },
    "witness_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witnessChange"
      }
    },
    "collapse_surface": {
      "$ref": "#/$defs/collapseSurface"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stringArrayChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "$ref": "#/$defs/stringArray"
        },
        "removed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "subjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "worldView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "summary",
        "subject",
        "first_class_terms",
        "core_questions",
        "compare_questions",
        "contract_refs"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/subjectSummary"
        },
        "first_class_terms": {
          "$ref": "#/$defs/stringArray"
        },
        "core_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "contract_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_witness_bundle",
        "candidate_witness_bundle",
        "output_root",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "baseline_witness_bundle": {
          "type": "string"
        },
        "candidate_witness_bundle": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "bundleStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_result",
        "candidate_result",
        "baseline_state",
        "candidate_state",
        "baseline_required_missing_count",
        "candidate_required_missing_count",
        "baseline_missing_contract_count",
        "candidate_missing_contract_count"
      ],
      "properties": {
        "baseline_result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "candidate_result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "baseline_state": {
          "type": "string",
          "enum": [
            "standing",
            "collapsed"
          ]
        },
        "candidate_state": {
          "type": "string",
          "enum": [
            "standing",
            "collapsed"
          ]
        },
        "baseline_required_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_required_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_missing_contract_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_missing_contract_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worldChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "summary_changed",
        "subject_changes",
        "first_class_term_changes",
        "core_question_changes",
        "compare_question_changes",
        "contract_ref_changes",
        "witness_plan_changes"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "summary_changed": {
          "type": "boolean"
        },
        "subject_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "first_class_term_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "core_question_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "compare_question_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "contract_ref_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "witness_plan_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        }
      }
    },
    "contractDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "present_ref_changes",
        "missing_ref_changes"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "present_ref_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "missing_ref_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        }
      }
    },
    "witnessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_entry_count",
        "candidate_entry_count",
        "changed_entry_count",
        "added_entry_count",
        "removed_entry_count",
        "unchanged_entry_count",
        "regression_count",
        "improvement_count",
        "neutral_change_count",
        "required_regression_count"
      ],
      "properties": {
        "baseline_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "added_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "removed_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "improvement_count": {
          "type": "integer",
          "minimum": 0
        },
        "neutral_change_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_regression_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "witnessChangeKind": {
      "type": "string",
      "enum": [
        "added",
        "removed",
        "changed"
      ]
    },
    "witnessImpact": {
      "type": "string",
      "enum": [
        "neutral",
        "improvement",
        "regression"
      ]
    },
    "witnessEntryStatus": {
      "type": "string",
      "enum": [
        "absent",
        "ok",
        "missing",
        "fail"
      ]
    },
    "witnessChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change_kind",
        "impact",
        "required",
        "kind",
        "label",
        "layer",
        "role",
        "witness_focus",
        "left_status",
        "right_status",
        "left_source_path",
        "right_source_path",
        "subject_changes",
        "observations_added",
        "observations_removed",
        "artifact_refs_added",
        "artifact_refs_removed",
        "metadata_changes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "change_kind": {
          "$ref": "#/$defs/witnessChangeKind"
        },
        "impact": {
          "$ref": "#/$defs/witnessImpact"
        },
        "required": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "witness_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "left_status": {
          "$ref": "#/$defs/witnessEntryStatus"
        },
        "right_status": {
          "$ref": "#/$defs/witnessEntryStatus"
        },
        "left_source_path": {
          "$ref": "#/$defs/nullableString"
        },
        "right_source_path": {
          "$ref": "#/$defs/nullableString"
        },
        "subject_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "observations_added": {
          "$ref": "#/$defs/stringArray"
        },
        "observations_removed": {
          "$ref": "#/$defs/stringArray"
        },
        "artifact_refs_added": {
          "$ref": "#/$defs/stringArray"
        },
        "artifact_refs_removed": {
          "$ref": "#/$defs/stringArray"
        },
        "metadata_changes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "collapseSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "regressed_witnesses",
        "required_regressed_witnesses",
        "failing_candidate_witnesses",
        "missing_candidate_witnesses",
        "added_missing_contract_refs",
        "affected_layers",
        "affected_focus",
        "narratives"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "regressed_witnesses": {
          "$ref": "#/$defs/stringArray"
        },
        "required_regressed_witnesses": {
          "$ref": "#/$defs/stringArray"
        },
        "failing_candidate_witnesses": {
          "$ref": "#/$defs/stringArray"
        },
        "missing_candidate_witnesses": {
          "$ref": "#/$defs/stringArray"
        },
        "added_missing_contract_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_layers": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
