      "const": "minimal_kernel.runtime_session_witness_inspect_compare_consumer/v0"
    },
    "kind": {
      "const": "minimal_kernel.runtime_session_witness_inspect_compare_consumer"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "compare_consumer": {
      "$ref": "#/$defs/titleBlock"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "source_compare": {
      "$ref": "#/$defs/sourceCompare"
    },
    "consumer_status": {
      "$ref": "#/$defs/consumerStatus"
    },
    "default_focus": {
      "$ref": "#/$defs/focusEntry"
    },
    "default_explain_hop": {
      "$ref": "#/$defs/explainHop"
    },
    "fallback_explain_hops": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/explainHop"
      }
    },
    "focus_entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/focusEntry"
      }
    },
    "readiness_surface": {
      "$ref": "#/$defs/readinessSurface"
    },
    "supporting_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
