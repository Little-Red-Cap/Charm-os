set(CHARM_RK3506_TARGET_DIR "${CMAKE_CURRENT_LIST_DIR}")
charm_get_source_root(_CHARM_RK3506_SOURCE_ROOT)

set(CHARM_RK3506_STARTUP_SOURCES
    "${CHARM_RK3506_TARGET_DIR}/startup.S"
    "${CHARM_RK3506_TARGET_DIR}/vectors.S")
set(CHARM_RK3506_PLATFORM_SOURCES
    "${CHARM_RK3506_TARGET_DIR}/rk3506_platform.cpp"
    "${CHARM_RK3506_TARGET_DIR}/rk3506_bootstrap.cpp"
    "${CHARM_RK3506_TARGET_DIR}/rk3506_exceptions.cpp"
    "${CHARM_RK3506_TARGET_DIR}/rk3506_bootstrap_runtime.cpp")
set(CHARM_RK3506_BOARD_SOURCES)
set(CHARM_RK3506_INCLUDE_DIRECTORIES
    "${CHARM_RK3506_TARGET_DIR}")
set(CHARM_RK3506_DEPENDS)

set(_CHARM_RK3506_GENERATED_DIR
    "${CMAKE_CURRENT_BINARY_DIR}/generated/rk3506")
file(MAKE_DIRECTORY "${_CHARM_RK3506_GENERATED_DIR}")

if (CHARM_RK3506_BRINGUP_STAGE STREQUAL "minimal")
    set(_CHARM_RK3506_BRINGUP_LEVEL 0)
elseif (CHARM_RK3506_BRINGUP_STAGE STREQUAL "observe")
    set(_CHARM_RK3506_BRINGUP_LEVEL 1)
elseif (CHARM_RK3506_BRINGUP_STAGE STREQUAL "irq-smoke")
    set(_CHARM_RK3506_BRINGUP_LEVEL 2)
else()
    message(FATAL_ERROR
        "Unsupported CHARM_RK3506_BRINGUP_STAGE='${CHARM_RK3506_BRINGUP_STAGE}'. "
        "Expected one of: minimal, observe, irq-smoke.")
endif()

set(CHARM_RK3506_COMPILE_DEFINITIONS
    CHARM_RK3506_SYSTEM_SRAM_BASE=${CHARM_RK3506_SYSTEM_SRAM_BASE}
    CHARM_RK3506_SYSTEM_SRAM_SIZE=${CHARM_RK3506_SYSTEM_SRAM_SIZE}
    CHARM_RK3506_SDRAM_BASE=${CHARM_RK3506_SDRAM_BASE}
    CHARM_RK3506_SDRAM_SIZE=${CHARM_RK3506_SDRAM_SIZE}
    CHARM_RK3506_IMAGE_TEXT_BASE=${CHARM_RK3506_IMAGE_TEXT_BASE}
    CHARM_RK3506_UART0_BASE=${CHARM_RK3506_UART0_BASE}
    CHARM_RK3506_UART4_BASE=${CHARM_RK3506_UART4_BASE}
    CHARM_RK3506_GPIO0_IOC_BASE=${CHARM_RK3506_GPIO0_IOC_BASE}
    CHARM_RK3506_EARLY_UART_BASE=${CHARM_RK3506_EARLY_UART_BASE}
    CHARM_RK3506_EARLY_UART_BAUD_RATE=${CHARM_RK3506_EARLY_UART_BAUD_RATE}
    CHARM_RK3506_UART_REG_SHIFT=${CHARM_RK3506_UART_REG_SHIFT}
    CHARM_RK3506_XIN_OSC_HZ=${CHARM_RK3506_XIN_OSC_HZ}
    CHARM_RK3506_GICD_BASE=${CHARM_RK3506_GICD_BASE}
    CHARM_RK3506_GICC_BASE=${CHARM_RK3506_GICC_BASE}
    CHARM_RK3506_GRF_BASE=${CHARM_RK3506_GRF_BASE}
    CHARM_RK3506_GRF_PMU_BASE=${CHARM_RK3506_GRF_PMU_BASE}
    CHARM_RK3506_CRU_BASE=${CHARM_RK3506_CRU_BASE}
    CHARM_RK3506_SCRU_BASE=${CHARM_RK3506_SCRU_BASE}
    CHARM_RK3506_GENERIC_TIMER_FREQUENCY_HZ=${CHARM_RK3506_GENERIC_TIMER_FREQUENCY_HZ}
    CHARM_RK3506_GENERIC_TIMER_EXPECTED_INTID=${CHARM_RK3506_GENERIC_TIMER_EXPECTED_INTID}
    CHARM_RK3506_BRINGUP_LEVEL=${_CHARM_RK3506_BRINGUP_LEVEL})
set(CHARM_RK3506_COMPILE_OPTIONS)
set(CHARM_RK3506_LINK_OPTIONS)
set(CHARM_RK3506_BOOTSTRAP_LINK_LIBRARIES)
set(CHARM_RK3506_LINKER_SCRIPT
    "${_CHARM_RK3506_GENERATED_DIR}/rk3506-baremetal-skeleton.ld")
configure_file(
    "${CHARM_RK3506_TARGET_DIR}/linker.ld.in"
    "${CHARM_RK3506_LINKER_SCRIPT}"
    @ONLY)

set(CHARM_RK3506_ALL_SOURCES
    ${CHARM_RK3506_STARTUP_SOURCES}
    ${CHARM_RK3506_PLATFORM_SOURCES}
    ${CHARM_RK3506_BOARD_SOURCES})
list(REMOVE_DUPLICATES CHARM_RK3506_ALL_SOURCES)
