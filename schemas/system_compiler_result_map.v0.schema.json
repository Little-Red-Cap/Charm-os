{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler_result_map.v0.schema.json",
  "title": "system_compiler_result_map/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "mode",
    "input_bridge",
    "case_projection_fields",
    "case_projection_field_relations",
    "stage_blocks"
  ],
  "properties": {
    "kind": {
      "const": "system_compiler_result_map/v0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "summary",
        "comparison"
      ]
    },
    "input_bridge": {
      "$ref": "#/$defs/resultMapBridge"
    },
    "case_projection_fields": {
      "$ref": "#/$defs/caseProjectionFields"
    },
    "case_projection_field_relations": {
      "$ref": "#/$defs/caseProjectionFieldRelations"
    },
    "stage_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stageBlock"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootFieldRelationKind": {
      "type": "string",
      "enum": [
        "same_field",
        "field_alias",
        "none"
      ]
    },
    "projectionSourceRelationKind": {
      "type": "string",
      "enum": [
        "same_field",
        "field_alias"
      ]
    },
    "stageName": {
      "type": "string",
      "enum": [
        "formation",
        "binding",
        "bringup"
      ]
    },
    "projectionSourceStage": {
      "type": "string",
      "enum": [
        "system_input",
        "system_formation",
        "binding_result",
        "bringup_order"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rootFieldRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_field",
        "block_field_path",
        "block_relation",
        "summary_field_path",
        "summary_relation"
      ],
      "properties": {
        "root_field": {
          "type": "string"
        },
        "block_field_path": {
          "$ref": "#/$defs/nullableString"
        },
        "block_relation": {
          "$ref": "#/$defs/rootFieldRelationKind"
        },
        "summary_field_path": {
          "$ref": "#/$defs/nullableString"
        },
        "summary_relation": {
          "$ref": "#/$defs/rootFieldRelationKind"
        }
      }
    },
    "resultMapBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_field",
        "root_fields",
        "field_relations"
      ],
      "properties": {
        "summary_field": {
          "type": "string"
        },
        "root_fields": {
          "$ref": "#/$defs/stringArray"
        },
        "field_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rootFieldRelation"
          }
        }
      }
    },
    "caseProjectionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formation",
        "binding",
        "bringup"
      ],
      "properties": {
        "formation": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "bringup": {
          "type": "string"
        }
      }
    },
    "caseProjectionSourceCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "field_path",
        "relation"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/projectionSourceStage"
        },
        "field_path": {
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/projectionSourceRelationKind"
        }
      }
    },
    "caseProjectionFieldRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_field",
        "source_candidates"
      ],
      "properties": {
        "projection_field": {
          "type": "string"
        },
        "source_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseProjectionSourceCandidate"
          },
          "minItems": 1
        }
      }
    },
    "caseProjectionFieldRelations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formation",
        "binding",
        "bringup"
      ],
      "properties": {
        "formation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseProjectionFieldRelation"
          }
        },
        "binding": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseProjectionFieldRelation"
          }
        },
        "bringup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseProjectionFieldRelation"
          }
        }
      }
    },
    "stageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "block_field",
        "summary_field",
        "root_fields",
        "field_relations"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stageName"
        },
        "block_field": {
          "type": "string"
        },
        "summary_field": {
          "type": "string"
        },
        "root_fields": {
          "$ref": "#/$defs/stringArray"
        },
        "field_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rootFieldRelation"
          }
        }
      }
    }
  }
}
