{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/minimal_kernel.runtime_evidence_bundle.summary.v1.schema.json",
  "title": "minimal_kernel.runtime_evidence_bundle.summary/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "result",
    "output_root",
    "report_markdown_path",
    "check_text_path",
    "host",
    "qemu",
    "session",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "minimal_kernel.runtime_evidence_bundle.summary/v1"
    },
    "generated_at": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "output_root": {
      "type": "string"
    },
    "report_markdown_path": {
      "type": "string"
    },
    "check_text_path": {
      "type": "string"
    },
    "host": {
      "$ref": "#/$defs/hostBundle"
    },
    "qemu": {
      "$ref": "#/$defs/qemuBundle"
    },
    "witness_bundle": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/witnessBundleView"
          }
        }
      ]
    },
    "session": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/sessionView"
          }
        }
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "statusCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "fail",
        "other"
      ],
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "other": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "elapsedStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "average",
        "median",
        "min",
        "max"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "average": {
          "type": "integer",
          "minimum": 0
        },
        "median": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hostConfigure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "executed"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "reused": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trapIngressWitnessTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "service",
        "origin",
        "disposition",
        "error"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "disposition": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "trapIngressWitnessLastFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "prior_attempt",
        "sequence",
        "stage",
        "service",
        "origin",
        "disposition",
        "error"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "prior_attempt": {
          "type": "boolean"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "stage": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "disposition": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "trapIngressWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "ok",
        "sequence",
        "stamp",
        "stages",
        "terminal",
        "last_failure"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "stamp": {
          "type": "integer",
          "minimum": 0
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decode",
            "dispatch",
            "writeback"
          ],
          "properties": {
            "decode": {
              "type": "boolean"
            },
            "dispatch": {
              "type": "boolean"
            },
            "writeback": {
              "type": "boolean"
            }
          }
        },
        "terminal": {
          "$ref": "#/$defs/trapIngressWitnessTerminal"
        },
        "last_failure": {
          "$ref": "#/$defs/trapIngressWitnessLastFailure"
        }
      }
    },
    "trapIngressWitnessEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "example",
        "status",
        "trap_ingress_witness"
      ],
      "properties": {
        "example": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "trap_ingress_witness": {
          "$ref": "#/$defs/trapIngressWitness"
        }
      }
    },
    "trapIngressWitnessSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_examples",
        "present_count",
        "ok_count",
        "missing_examples",
        "entries"
      ],
      "properties": {
        "expected_examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "present_count": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trapIngressWitnessEntry"
          }
        }
      }
    },
    "hostComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_summary_path",
        "matched_examples",
        "regressions",
        "improvements",
        "added_examples",
        "removed_examples"
      ],
      "properties": {
        "baseline_summary_path": {
          "type": "string"
        },
        "matched_examples": {
          "type": "integer",
          "minimum": 0
        },
        "regressions": {
          "type": "integer",
          "minimum": 0
        },
        "improvements": {
          "type": "integer",
          "minimum": 0
        },
        "added_examples": {
          "type": "integer",
          "minimum": 0
        },
        "removed_examples": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hostInspectView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "inspect_json_path",
        "report_markdown_path",
        "check_text_path",
        "profile",
        "example_count",
        "status",
        "elapsed_ms"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "inspect_json_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "example_count": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/statusCount"
        },
        "elapsed_ms": {
          "$ref": "#/$defs/elapsedStats"
        },
        "configure": {
          "$ref": "#/$defs/hostConfigure"
        },
        "trap_ingress_witnesses": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/trapIngressWitnessSet"
              }
            }
          ]
        },
        "comparison": {
          "$ref": "#/$defs/hostComparison"
        }
      }
    },
    "hostBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "bundle_log_path",
        "bundle_exit_code",
        "cold",
        "warm"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "bundle_log_path": {
          "type": "string"
        },
        "bundle_exit_code": {
          "type": "integer"
        },
        "cold": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/hostInspectView"
              }
            }
          ]
        },
        "warm": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/hostInspectView"
              }
            }
          ]
        }
      }
    },
    "qemuPhaseElapsed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configure",
        "build"
      ],
      "properties": {
        "configure": {
          "type": "integer",
          "minimum": 0
        },
        "build": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qemuCanonicalWorld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "subject",
        "environment",
        "profile",
        "focus"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qemuWitnessBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "question",
        "conclusion",
        "standing_cases",
        "regressed_cases"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "conclusion": {
          "type": "string"
        },
        "standing_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regressed_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qemuBiography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "thesis",
        "evidence_path",
        "next_questions"
      ],
      "properties": {
        "identity": {
          "type": "string"
        },
        "thesis": {
          "type": "string"
        },
        "evidence_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qemuCanonicalCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "seam",
        "world_state"
      ],
      "properties": {
        "world": {
          "type": "string"
        },
        "seam": {
          "type": "string"
        },
        "world_state": {
          "type": "string"
        }
      }
    },
    "qemuWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "question"
      ],
      "properties": {
        "claim": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      }
    },
    "qemuResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "label",
        "status",
        "elapsed_ms",
        "stdout_log_path",
        "stderr_log_path",
        "canonical_case",
        "witness",
        "detail"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "stdout_log_path": {
          "type": "string"
        },
        "stderr_log_path": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical_case": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuCanonicalCase"
              }
            }
          ]
        },
        "witness": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuWitness"
              }
            }
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "qemuFatalFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "message"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "qemuSummaryView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "case_count",
        "completed_case_count",
        "canonical_world",
        "witness_bundle",
        "biography",
        "status",
        "elapsed_ms",
        "phase_elapsed_ms",
        "results"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "canonical_world": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuCanonicalWorld"
              }
            }
          ]
        },
        "witness_bundle": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuWitnessBundle"
              }
            }
          ]
        },
        "biography": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuBiography"
              }
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/statusCount"
        },
        "elapsed_ms": {
          "$ref": "#/$defs/elapsedStats"
        },
        "phase_elapsed_ms": {
          "$ref": "#/$defs/qemuPhaseElapsed"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qemuResult"
          }
        },
        "fatal_failure": {
          "$ref": "#/$defs/qemuFatalFailure"
        }
      }
    },
    "qemuBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "bundle_log_path",
        "bundle_exit_code",
        "lower_half"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "bundle_log_path": {
          "type": "string"
        },
        "bundle_exit_code": {
          "type": "integer"
        },
        "lower_half": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/qemuSummaryView"
              }
            }
          ]
        }
      }
    },
    "witnessBundleWorld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "witnessBundleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_count",
        "ok_count",
        "missing_count",
        "fail_count",
        "required_missing_count"
      ],
      "properties": {
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "fail_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_missing_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "witnessBundleView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_world_path",
        "output_root",
        "bundle_log_path",
        "bundle_exit_code",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "result",
        "world",
        "witness_summary"
      ],
      "properties": {
        "canonical_world_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_root": {
          "type": "string"
        },
        "bundle_log_path": {
          "type": "string"
        },
        "bundle_exit_code": {
          "type": "integer"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "world": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/witnessBundleWorld"
              }
            }
          ]
        },
        "witness_summary": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/witnessBundleSummary"
              }
            }
          ]
        }
      }
    },
    "sessionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "bundle_log_path",
        "bundle_exit_code",
        "summary_path",
        "runtime_ledger_path",
        "report_markdown_path",
        "check_text_path",
        "result",
        "session_id",
        "world",
        "session_status",
        "failure_domain",
        "failure_count"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "bundle_log_path": {
          "type": "string"
        },
        "bundle_exit_code": {
          "type": "integer"
        },
        "summary_path": {
          "type": "string"
        },
        "runtime_ledger_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "world": {
          "type": "string"
        },
        "session_status": {
          "type": "string",
          "enum": [
            "standing",
            "drifted",
            "collapsed"
          ]
        },
        "failure_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
