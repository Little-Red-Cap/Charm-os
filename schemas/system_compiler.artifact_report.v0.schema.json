{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.artifact_report.v0.schema.json",
  "title": "system_compiler.artifact_report/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "generator",
    "report_kind",
    "mode",
    "subject",
    "structure",
    "bringup_evidence",
    "resource_contract",
    "runtime_observe",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.artifact_report/v0"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "report_kind": {
      "const": "system_compiler.artifact_report"
    },
    "mode": {
      "type": "string",
      "enum": [
        "export_only",
        "compare"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "structure": {
      "$ref": "#/$defs/structure"
    },
    "connection_summary": {
      "$ref": "#/$defs/connectionSummary"
    },
    "bringup_evidence": {
      "$ref": "#/$defs/bringupEvidence"
    },
    "resource_contract": {
      "$ref": "#/$defs/resourceContract"
    },
    "runtime_observe": {
      "$ref": "#/$defs/runtimeObserve"
    },
    "comparison": {
      "$ref": "#/$defs/comparisonSummary"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "stringCountMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "published"
      ],
      "properties": {
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "published": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "exportStateCountMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "detached",
        "attached"
      ],
      "properties": {
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "detached": {
          "type": "integer",
          "minimum": 0
        },
        "attached": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resourceContractClause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requires"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "may_block",
            "needs_heap",
            "needs_reactor",
            "needs_monotonic_clock",
            "irq_safe"
          ]
        },
        "requires": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_count",
        "node_count",
        "edge_count",
        "declared_facts",
        "required_facts",
        "unresolved_bindings"
      ],
      "properties": {
        "capability_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "materialized_order": {
          "$ref": "#/$defs/stringArray"
        },
        "declared_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "required_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolved_bindings": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "connectionSummaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "phase",
        "runlevel_text",
        "source",
        "sink",
        "mode",
        "requires"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/nullableString"
        },
        "runlevel_text": {
          "$ref": "#/$defs/nullableString"
        },
        "source": {
          "$ref": "#/$defs/nullableString"
        },
        "sink": {
          "$ref": "#/$defs/nullableString"
        },
        "mode": {
          "$ref": "#/$defs/nullableString"
        },
        "requires": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "connectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_node_count",
        "connection_modes",
        "connections"
      ],
      "properties": {
        "connection_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "connection_modes": {
          "$ref": "#/$defs/countMap"
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connectionSummaryEntry"
          }
        }
      }
    },
    "bringupEvidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "declared",
        "materialized",
        "published",
        "observed",
        "blocked",
        "failed",
        "provider_nodes",
        "consumer_nodes",
        "blocked_reasons",
        "failed_reasons"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "declared": {
          "type": "boolean"
        },
        "materialized": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "observed": {
          "type": "boolean"
        },
        "blocked": {
          "type": "boolean"
        },
        "failed": {
          "type": "boolean"
        },
        "publish_state": {
          "$ref": "#/$defs/nullableString"
        },
        "export_state": {
          "$ref": "#/$defs/nullableString"
        },
        "provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "failed_reasons": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bringupEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_count",
        "materialized_count",
        "published_count",
        "observed_count",
        "blocked_count",
        "failed_count"
      ],
      "properties": {
        "declared_count": {
          "type": "integer",
          "minimum": 0
        },
        "materialized_count": {
          "type": "integer",
          "minimum": 0
        },
        "published_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "published_capabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "failed_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bringupEvidenceEntry"
          }
        }
      }
    },
    "resourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_contracts",
        "declared_contract_entries",
        "provided_facts",
        "audited_count",
        "satisfied_count",
        "violated_count",
        "unknown_count",
        "satisfied_contracts"
      ],
      "properties": {
        "declared_contracts": {
          "type": "integer",
          "minimum": 0
        },
        "declared_contract_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceContractClause"
          }
        },
        "provided_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "audited_count": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied_count": {
          "type": "integer",
          "minimum": 0
        },
        "violated_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied_contracts": {
          "$ref": "#/$defs/stringArray"
        },
        "violations": {
          "$ref": "#/$defs/stringArray"
        },
        "unknown_contracts": {
          "$ref": "#/$defs/stringArray"
        },
        "resource_hotspots": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "transitionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "action",
        "before",
        "after"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "runtimeObserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publish_state_summary",
        "export_state_summary"
      ],
      "properties": {
        "observed_capabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "publish_state_summary": {
          "$ref": "#/$defs/stringCountMap"
        },
        "export_state_summary": {
          "$ref": "#/$defs/exportStateCountMap"
        },
        "recent_transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transitionSummary"
          }
        }
      }
    },
    "changeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stringArrayChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "$ref": "#/$defs/stringArray"
        },
        "removed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bringupEvidenceComparisonSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_count",
        "materialized_count",
        "published_count",
        "observed_count",
        "blocked_count",
        "failed_count",
        "published_capabilities",
        "blocked_reasons",
        "failed_reasons"
      ],
      "properties": {
        "declared_count": {
          "type": "integer",
          "minimum": 0
        },
        "materialized_count": {
          "type": "integer",
          "minimum": 0
        },
        "published_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "published_capabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "blocked_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "failed_reasons": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bringupEvidenceComparisonCapabilityChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "change_kind",
        "left_declared",
        "right_declared",
        "left_materialized",
        "right_materialized",
        "left_published",
        "right_published",
        "left_observed",
        "right_observed",
        "left_blocked",
        "right_blocked",
        "left_failed",
        "right_failed",
        "left_publish_state",
        "right_publish_state",
        "left_export_state",
        "right_export_state",
        "left_provider_nodes",
        "right_provider_nodes",
        "left_consumer_nodes",
        "right_consumer_nodes",
        "left_blocked_reasons",
        "right_blocked_reasons",
        "left_failed_reasons",
        "right_failed_reasons"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "change_kind": {
          "type": "string",
          "enum": [
            "added",
            "removed",
            "changed"
          ]
        },
        "left_declared": {
          "type": "boolean"
        },
        "right_declared": {
          "type": "boolean"
        },
        "left_materialized": {
          "type": "boolean"
        },
        "right_materialized": {
          "type": "boolean"
        },
        "left_published": {
          "type": "boolean"
        },
        "right_published": {
          "type": "boolean"
        },
        "left_observed": {
          "type": "boolean"
        },
        "right_observed": {
          "type": "boolean"
        },
        "left_blocked": {
          "type": "boolean"
        },
        "right_blocked": {
          "type": "boolean"
        },
        "left_failed": {
          "type": "boolean"
        },
        "right_failed": {
          "type": "boolean"
        },
        "left_publish_state": {
          "$ref": "#/$defs/nullableString"
        },
        "right_publish_state": {
          "$ref": "#/$defs/nullableString"
        },
        "left_export_state": {
          "$ref": "#/$defs/nullableString"
        },
        "right_export_state": {
          "$ref": "#/$defs/nullableString"
        },
        "left_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_blocked_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "right_blocked_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "left_failed_reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "right_failed_reasons": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "bringupEvidenceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "left",
        "right",
        "summary_changes",
        "capability_changes",
        "published_capability_changes",
        "blocked_reason_changes",
        "failed_reason_changes"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "left": {
          "$ref": "#/$defs/bringupEvidenceComparisonSide"
        },
        "right": {
          "$ref": "#/$defs/bringupEvidenceComparisonSide"
        },
        "summary_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "capability_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bringupEvidenceComparisonCapabilityChange"
          }
        },
        "published_capability_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "blocked_reason_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "failed_reason_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        }
      }
    },
    "resourceContractComparisonSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_contracts",
        "audited_count",
        "satisfied_count",
        "violated_count",
        "unknown_count",
        "provided_facts",
        "resource_hotspots"
      ],
      "properties": {
        "declared_contracts": {
          "type": "integer",
          "minimum": 0
        },
        "audited_count": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied_count": {
          "type": "integer",
          "minimum": 0
        },
        "violated_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_count": {
          "type": "integer",
          "minimum": 0
        },
        "provided_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "resource_hotspots": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "resourceContractComparisonContractChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "change_kind",
        "left_state",
        "right_state",
        "left_requires",
        "right_requires",
        "left_status_text",
        "right_status_text"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "may_block",
            "needs_heap",
            "needs_reactor",
            "needs_monotonic_clock",
            "irq_safe"
          ]
        },
        "change_kind": {
          "type": "string",
          "enum": [
            "added",
            "removed",
            "changed"
          ]
        },
        "left_state": {
          "type": "string",
          "enum": [
            "absent",
            "declared",
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "right_state": {
          "type": "string",
          "enum": [
            "absent",
            "declared",
            "satisfied",
            "violated",
            "unknown"
          ]
        },
        "left_requires": {
          "$ref": "#/$defs/stringArray"
        },
        "right_requires": {
          "$ref": "#/$defs/stringArray"
        },
        "left_status_text": {
          "$ref": "#/$defs/nullableString"
        },
        "right_status_text": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "resourceContractComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "left",
        "right",
        "summary_changes",
        "contract_changes",
        "provided_fact_changes",
        "hotspot_changes"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "left": {
          "$ref": "#/$defs/resourceContractComparisonSide"
        },
        "right": {
          "$ref": "#/$defs/resourceContractComparisonSide"
        },
        "summary_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "contract_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceContractComparisonContractChange"
          }
        },
        "provided_fact_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        },
        "hotspot_changes": {
          "$ref": "#/$defs/stringArrayChanges"
        }
      }
    },
    "comparisonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary_changes",
        "metadata_changes",
        "node_changes",
        "edge_changes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "changed",
            "added",
            "removed",
            "unchanged"
          ]
        },
        "summary_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "metadata_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "node_changes": {
          "$ref": "#/$defs/changeCounts"
        },
        "edge_changes": {
          "$ref": "#/$defs/changeCounts"
        },
        "bringup_evidence": {
          "$ref": "#/$defs/bringupEvidenceComparison"
        },
        "resource_contract": {
          "$ref": "#/$defs/resourceContractComparison"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle",
        "input_manifest",
        "dot",
        "sample_json",
        "diff",
        "ci_summary",
        "report_manifest"
      ],
      "properties": {
        "bundle": {
          "$ref": "#/$defs/nullableString"
        },
        "input_manifest": {
          "$ref": "#/$defs/nullableString"
        },
        "dot": {
          "$ref": "#/$defs/nullableString"
        },
        "sample_json": {
          "$ref": "#/$defs/nullableString"
        },
        "runtime_observe": {
          "$ref": "#/$defs/nullableString"
        },
        "diff": {
          "$ref": "#/$defs/nullableString"
        },
        "ci_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "report_manifest": {
          "$ref": "#/$defs/nullableString"
        },
        "report_markdown": {
          "$ref": "#/$defs/nullableString"
        },
        "report_html": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
