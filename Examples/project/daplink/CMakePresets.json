{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/cmake-build-daplink-${presetName}",
            "displayName": "DAPLink base",
            "description": "DAPLink common configure preset.",
            "cacheVariables": {
                "DAPLINK_ENABLE_CHARM_INTEGRATION": "OFF"
            }
        },
        {
            "name": "f103-debug",
            "inherits": "base",
            "displayName": "F103 Debug",
            "description": "Build the F103 backend with the composite USB profile.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/f103"
            }
        },
        {
            "name": "f103-hid-debug",
            "inherits": "base",
            "displayName": "F103 HID Debug",
            "description": "Build the F103 backend with HID-only USB.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/f103",
                "DAPLINK_USB_PROFILE": "hid"
            }
        },
        {
            "name": "g431-debug",
            "inherits": "base",
            "displayName": "G431 Debug",
            "description": "Build the G431 backend with the composite USB profile.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/g431"
            }
        },
        {
            "name": "g431-hid-debug",
            "inherits": "base",
            "displayName": "G431 HID Debug",
            "description": "Build the G431 backend with HID-only USB.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/g431",
                "DAPLINK_USB_PROFILE": "hid"
            }
        },
        {
            "name": "h503-debug",
            "inherits": "base",
            "displayName": "H503 Debug",
            "description": "Build the H503 backend with the composite USB profile.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/h503"
            }
        },
        {
            "name": "h503-hid-debug",
            "inherits": "base",
            "displayName": "H503 HID Debug",
            "description": "Build the H503 backend with HID-only USB.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DAPLINK_PORT_DIR": "${sourceDir}/h503",
                "DAPLINK_USB_PROFILE": "hid"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "f103-debug",
            "configurePreset": "f103-debug",
            "targets": [
                "daplink"
            ]
        },
        {
            "name": "f103-hid-debug",
            "configurePreset": "f103-hid-debug",
            "targets": [
                "daplink"
            ]
        },
        {
            "name": "g431-debug",
            "configurePreset": "g431-debug",
            "targets": [
                "daplink"
            ]
        },
        {
            "name": "g431-hid-debug",
            "configurePreset": "g431-hid-debug",
            "targets": [
                "daplink"
            ]
        },
        {
            "name": "h503-debug",
            "configurePreset": "h503-debug",
            "targets": [
                "daplink"
            ]
        },
        {
            "name": "h503-hid-debug",
            "configurePreset": "h503-hid-debug",
            "targets": [
                "daplink"
            ]
        }
    ]
}
