        "baseline_primary_tab_id": {
          "type": "string"
        },
        "candidate_primary_tab_id": {
          "type": "string"
        },
        "primary_query_changed": {
          "type": "boolean"
        },
        "landing_regression_changed": {
          "type": "boolean"
        },
        "query_regression_changed": {
          "type": "boolean"
        },
        "landing_regression_affected_tab_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "query_regression_affected_tab_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "compareContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "related_landing_role",
        "landing_verdict",
        "primary_query_changed",
        "landing_regression_changed",
        "query_regression_changed",
        "narratives"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "related_landing_role": {
          "type": "string"
        },
        "landing_verdict": {
          "type": "string"
        },
        "primary_query_changed": {
          "type": "boolean"
        },
        "landing_regression_changed": {
          "type": "boolean"
        },
        "query_regression_changed": {
          "type": "boolean"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
