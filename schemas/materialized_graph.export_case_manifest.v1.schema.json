{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.dev/schemas/materialized_graph.export_case_manifest.v1.schema.json",
  "title": "Charm materialized graph export case manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "materialized_graph.export_case_manifest/v1"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseEntry"
      }
    }
  },
  "$defs": {
    "subjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "board": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_facets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resourceContractClause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requires"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "may_block",
            "needs_heap",
            "needs_reactor",
            "needs_monotonic_clock",
            "irq_safe"
          ]
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "caseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "build_dir",
        "build_target",
        "case_kind",
        "export_target",
        "dot_cache",
        "json_cache",
        "default_dot",
        "default_json",
        "extra_cache",
        "subject",
        "declared_contracts"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "build_dir": {
          "type": "string"
        },
        "build_target": {
          "type": "string"
        },
        "case_kind": {
          "type": "string",
          "enum": [
            "materialized_graph",
            "runtime_only",
            "fact_only"
          ]
        },
        "export_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "dot_cache": {
          "type": [
            "string",
            "null"
          ]
        },
        "json_cache": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_dot": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_json": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_observe_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_observe_cache": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_runtime_observe": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact_evidence_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact_evidence_cache": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_fact_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "declared_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_provided_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declared_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceContractClause"
          }
        },
        "extra_cache": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime_observe": {
          "type": [
            "string",
            "null"
          ]
        },
        "fact_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subjectSummary"
        }
      }
    }
  }
}
