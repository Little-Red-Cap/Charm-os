{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.world_shelf_review.v0.schema.json",
  "title": "system_compiler.world_shelf_review/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "review_verdict",
    "review",
    "front_page",
    "route_provenance",
    "artifact_context",
    "review_status",
    "questions",
    "drift_digest",
    "collapse_surface",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.world_shelf_review/v0"
    },
    "kind": {
      "const": "system_compiler.world_shelf_review"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "review_verdict": {
      "type": "string",
      "enum": [
        "candidate-only",
        "standing",
        "improved",
        "drifted",
        "collapsed"
      ]
    },
    "review": {
      "$ref": "#/$defs/reviewBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "route_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeProvenanceEntry"
      }
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "review_status": {
      "$ref": "#/$defs/reviewStatus"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "drift_digest": {
      "$ref": "#/$defs/driftDigest"
    },
    "collapse_surface": {
      "$ref": "#/$defs/collapseSurface"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "review_summary_path",
        "review_report_markdown_path",
        "review_check_text_path",
        "candidate_shelf_root",
        "candidate_shelf_summary",
        "baseline_shelf_root",
        "baseline_shelf_summary",
        "compare_output_root",
        "compare_summary_path"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "review_summary_path": {
          "type": "string"
        },
        "review_report_markdown_path": {
          "type": "string"
        },
        "review_check_text_path": {
          "type": "string"
        },
        "candidate_shelf_root": {
          "type": "string"
        },
        "candidate_shelf_summary": {
          "type": "string"
        },
        "baseline_shelf_root": {
          "$ref": "#/$defs/nullableString"
        },
        "baseline_shelf_summary": {
          "$ref": "#/$defs/nullableString"
        },
        "compare_output_root": {
          "$ref": "#/$defs/nullableString"
        },
        "compare_summary_path": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "routeProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_kind",
        "source_summary_schema",
        "source_summary_path",
        "source_front_page_summary_path",
        "source_front_page_report_markdown_path",
        "source_front_page_check_text_path",
        "available_supporting_surface_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "route_kind": {
          "type": "string",
          "enum": [
            "front_page_root"
          ]
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_front_page_summary_path": {
          "type": "string"
        },
        "source_front_page_report_markdown_path": {
          "type": "string"
        },
        "source_front_page_check_text_path": {
          "type": "string"
        },
        "available_supporting_surface_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "reviewStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_mode",
        "compare_enabled",
        "candidate_result",
        "baseline_result",
        "compare_result",
        "candidate_profile",
        "baseline_profile",
        "candidate_biography_count",
        "baseline_biography_count",
        "candidate_unique_world_count",
        "baseline_unique_world_count",
        "candidate_compare_attached_count",
        "baseline_compare_attached_count",
        "candidate_not_attached_count",
        "baseline_not_attached_count"
      ],
      "properties": {
        "compare_mode": {
          "type": "string",
          "enum": [
            "candidate-only",
            "self-compare",
            "baseline-compare"
          ]
        },
        "compare_enabled": {
          "type": "boolean"
        },
        "candidate_result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "baseline_result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ok",
            "fail",
            null
          ]
        },
        "compare_result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ok",
            "fail",
            null
          ]
        },
        "candidate_profile": {
          "type": "string"
        },
        "baseline_profile": {
          "$ref": "#/$defs/nullableString"
        },
        "candidate_biography_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_biography_count": {
          "$ref": "#/$defs/nullableInteger"
        },
        "candidate_unique_world_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_unique_world_count": {
          "$ref": "#/$defs/nullableInteger"
        },
        "candidate_compare_attached_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_compare_attached_count": {
          "$ref": "#/$defs/nullableInteger"
        },
        "candidate_not_attached_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_not_attached_count": {
          "$ref": "#/$defs/nullableInteger"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_questions",
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "candidate_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "driftDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "verdict",
        "entry_changed_count",
        "entry_regression_count",
        "entry_improvement_count",
        "front_page_entry_detail_changed_count",
        "front_page_entry_detail_changed_anchors",
        "removed_worlds",
        "added_failed_entries",
        "front_page_entry_detail_changed_anchors",
        "affected_worlds",
        "affected_profiles",
        "narratives"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "candidate-only",
            "standing",
            "improved",
            "drifted",
            "collapsed"
          ]
        },
        "entry_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_improvement_count": {
          "type": "integer",
          "minimum": 0
        },
        "front_page_entry_detail_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "front_page_entry_detail_changed_anchors": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_worlds": {
          "$ref": "#/$defs/stringArray"
        },
        "added_failed_entries": {
          "$ref": "#/$defs/stringArray"
        },
        "front_page_entry_detail_changed_anchors": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_worlds": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_profiles": {
          "$ref": "#/$defs/stringArray"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "collapseSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "regressed_entries",
        "removed_worlds",
        "added_failed_entries",
        "front_page_entry_detail_changed_anchors",
        "affected_worlds",
        "affected_profiles",
        "narratives"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "regressed_entries": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_worlds": {
          "$ref": "#/$defs/stringArray"
        },
        "added_failed_entries": {
          "$ref": "#/$defs/stringArray"
        },
        "front_page_entry_detail_changed_anchors": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_worlds": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_profiles": {
          "$ref": "#/$defs/stringArray"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
