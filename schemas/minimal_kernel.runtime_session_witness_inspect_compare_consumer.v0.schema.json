      }
    },
    "stringIntegerMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_compare_summary_path",
        "output_root",
        "consumer_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_compare_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "consumer_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "sourceCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_result",
        "changed",
        "baseline_summary_path",
        "candidate_summary_path",
        "baseline_result",
        "current_result",
        "baseline_session_status",
        "current_session_status",
        "baseline_failure_domain",
        "current_failure_domain",
        "runtime_regression_count",
        "runtime_improvement_count",
        "world_failure_code_delta_count",
        "witness_failure_code_delta_count",
        "violation_delta_count"
