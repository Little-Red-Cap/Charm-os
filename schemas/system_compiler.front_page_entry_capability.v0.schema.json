      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "routeProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_kind",
        "source_summary_schema",
        "source_summary_path",
        "source_input_summary_path",
        "source_root_summary_path",
        "source_report_markdown_path",
        "source_check_text_path",
        "level1_surface_ids"
