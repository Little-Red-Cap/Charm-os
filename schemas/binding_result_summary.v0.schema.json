{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/binding_result_summary.v0.schema.json",
  "title": "binding_result_summary/v0",
  "oneOf": [
    {
      "$ref": "#/$defs/summaryMode"
    },
    {
      "$ref": "#/$defs/comparisonMode"
    }
  ],
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stringOrStringArray": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/stringArray"
        }
      ]
    },
    "changeKind": {
      "type": "string",
      "enum": [
        "added",
        "removed",
        "changed"
      ]
    },
    "changeKindArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeKind"
      }
    },
    "namedChangeBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "$ref": "#/$defs/stringArray"
        },
        "removed": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "caseReferenceWithChangeKinds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "change_kinds"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "change_kinds": {
          "$ref": "#/$defs/changeKindArray"
        }
      }
    },
    "summaryTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_binding_count",
        "resolved_binding_count",
        "unresolved_binding_count"
      ],
      "properties": {
        "required_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_binding_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summaryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "board",
        "profile",
        "active_facets",
        "required_binding_count",
        "resolved_binding_count",
        "unresolved_binding_count",
        "resolved_capabilities",
        "unresolved_capabilities"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "board": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        },
        "required_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_binding_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_capabilities": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolved_capabilities": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "capabilityMatrixCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "state",
        "provider_nodes",
        "consumer_nodes",
        "reason"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "state": {
          "type": "string"
        },
        "provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "capabilityMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "case_count",
        "resolved_case_count",
        "unresolved_case_count",
        "states",
        "reasons",
        "provider_nodes",
        "consumer_nodes",
        "cases"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "states": {
          "$ref": "#/$defs/stringArray"
        },
        "reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "provider_nodes": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "consumer_nodes": {
          "$ref": "#/$defs/stringOrStringArray"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityMatrixCase"
          }
        }
      }
    },
    "comparisonCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "active_facets",
        "changed",
        "summary_changes",
        "binding_change_count",
        "capabilities_changed",
        "resolved_capability_changes",
        "unresolved_capability_changes",
        "binding_changes"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "board": {
          "type": "string"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        },
        "changed": {
          "type": "boolean"
        },
        "summary_changes": {
          "$ref": "#/$defs/stringArray"
        },
        "binding_change_count": {
          "type": "integer",
          "minimum": 0
        },
        "capabilities_changed": {
          "$ref": "#/$defs/stringArray"
        },
        "resolved_capability_changes": {
          "$ref": "#/$defs/namedChangeBucket"
        },
        "unresolved_capability_changes": {
          "$ref": "#/$defs/namedChangeBucket"
        },
        "binding_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bindingChange"
          }
        }
      }
    },
    "bindingChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "change_kind",
        "left_state",
        "right_state",
        "left_provider_nodes",
        "right_provider_nodes",
        "left_consumer_nodes",
        "right_consumer_nodes",
        "left_reason",
        "right_reason"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "change_kind": {
          "$ref": "#/$defs/changeKind"
        },
        "left_state": {
          "$ref": "#/$defs/nullableString"
        },
        "right_state": {
          "$ref": "#/$defs/nullableString"
        },
        "left_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "right_reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "summaryChangeMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "case_count",
        "cases"
      ],
      "properties": {
        "change": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseReference"
          }
        }
      }
    },
    "capabilityChangeMatrixCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "change_kind",
        "left_state",
        "right_state",
        "left_provider_nodes",
        "right_provider_nodes",
        "left_consumer_nodes",
        "right_consumer_nodes",
        "left_reason",
        "right_reason"
      ],
      "properties": {
        "case": {
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "change_kind": {
          "$ref": "#/$defs/changeKind"
        },
        "left_state": {
          "$ref": "#/$defs/nullableString"
        },
        "right_state": {
          "$ref": "#/$defs/nullableString"
        },
        "left_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_provider_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "right_consumer_nodes": {
          "$ref": "#/$defs/stringArray"
        },
        "left_reason": {
          "$ref": "#/$defs/nullableString"
        },
        "right_reason": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "capabilityChangeMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "case_count",
        "change_kinds",
        "states",
        "reasons",
        "cases"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "change_kinds": {
          "$ref": "#/$defs/changeKindArray"
        },
        "states": {
          "$ref": "#/$defs/stringArray"
        },
        "reasons": {
          "$ref": "#/$defs/stringArray"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityChangeMatrixCase"
          }
        }
      }
    },
    "namedCapabilityChangeMatrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "case_count",
        "change_kinds",
        "cases"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "change_kinds": {
          "$ref": "#/$defs/changeKindArray"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseReferenceWithChangeKinds"
          }
        }
      }
    },
    "summaryMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "case_count",
        "totals",
        "cases",
        "capability_matrix",
        "resolved_capability_matrix",
        "unresolved_capability_matrix"
      ],
      "properties": {
        "kind": {
          "const": "binding_result_summary/v0"
        },
        "mode": {
          "const": "summary"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "totals": {
          "$ref": "#/$defs/summaryTotals"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summaryCase"
          }
        },
        "capability_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityMatrixEntry"
          }
        },
        "resolved_capability_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityMatrixEntry"
          }
        },
        "unresolved_capability_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityMatrixEntry"
          }
        }
      }
    },
    "comparisonMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "compared_case_count",
        "changed_case_count",
        "unchanged_case_count",
        "changed_cases",
        "unchanged_cases",
        "binding_change_count",
        "cases",
        "summary_change_matrix",
        "capability_change_matrix",
        "resolved_capability_change_matrix",
        "unresolved_capability_change_matrix"
      ],
      "properties": {
        "kind": {
          "const": "binding_result_summary/v0"
        },
        "mode": {
          "const": "comparison"
        },
        "compared_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "changed_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "unchanged_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "binding_change_count": {
          "type": "integer",
          "minimum": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparisonCase"
          }
        },
        "summary_change_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summaryChangeMatrixEntry"
          }
        },
        "capability_change_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityChangeMatrixEntry"
          }
        },
        "resolved_capability_change_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedCapabilityChangeMatrixEntry"
          }
        },
        "unresolved_capability_change_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedCapabilityChangeMatrixEntry"
          }
        }
      }
    }
  }
}
