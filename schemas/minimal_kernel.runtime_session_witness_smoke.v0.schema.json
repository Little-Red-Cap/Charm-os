{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/minimal_kernel.runtime_session_witness_smoke.v0.schema.json",
  "title": "minimal_kernel.runtime_session_witness_smoke/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at",
    "result",
    "output_root",
    "artifacts",
    "checks",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "minimal_kernel.runtime_session_witness_smoke/v0"
    },
    "kind": {
      "const": "minimal_kernel.runtime_session_witness_smoke"
    },
    "generated_at": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "output_root": {
      "type": "string"
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "checks": {
      "$ref": "#/$defs/checks"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pathGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "summary",
        "report_markdown",
        "check_text"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "report_markdown": {
          "type": "string"
        },
        "check_text": {
          "type": "string"
        }
      }
    },
    "sessionArtifactGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "summary",
        "runtime_ledger",
        "report_markdown",
        "check_text"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "runtime_ledger": {
          "type": "string"
        },
        "report_markdown": {
          "type": "string"
        },
        "check_text": {
          "type": "string"
        }
      }
    },
    "witnessFailureExportArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "baseline_summary",
        "candidate_summary",
        "world_compare_summary",
        "world_compare_report_markdown",
        "world_compare_check_text"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "baseline_summary": {
          "type": "string"
        },
        "candidate_summary": {
          "type": "string"
        },
        "world_compare_summary": {
          "type": "string"
        },
        "world_compare_report_markdown": {
          "type": "string"
        },
        "world_compare_check_text": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "report_markdown",
        "check_text",
        "session",
        "world_compare_session_drift",
        "witness_session_failure_export"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "report_markdown": {
          "type": "string"
        },
        "check_text": {
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/sessionArtifactGroup"
        },
        "world_compare_session_drift": {
          "$ref": "#/$defs/pathGroup"
        },
        "witness_session_failure_export": {
          "$ref": "#/$defs/witnessFailureExportArtifacts"
        }
      }
    },
    "runtimeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "trap",
        "thread",
        "task_syscall",
        "handoff_continuity"
      ],
      "properties": {
        "tick": {
          "type": "boolean"
        },
        "trap": {
          "type": "boolean"
        },
        "thread": {
          "type": "boolean"
        },
        "task_syscall": {
          "type": "boolean"
        },
        "handoff_continuity": {
          "type": "boolean"
        }
      }
    },
    "sessionCheck": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "world",
              "session_status",
              "failure_domain",
              "failure_count",
              "runtime",
              "ledger_event_count"
            ],
            "properties": {
              "session_id": {
                "type": "string"
              },
              "world": {
                "type": "string"
              },
              "session_status": {
                "type": "string",
                "enum": [
                  "standing",
                  "degraded",
                  "collapsed",
                  "missing"
                ]
              },
              "failure_domain": {
                "$ref": "#/$defs/nullableString"
              },
              "failure_count": {
                "type": "integer",
                "minimum": 0
              },
              "runtime": {
                "$ref": "#/$defs/runtimeFacts"
              },
              "ledger_event_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "sessionDrift": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changed",
              "regressed_sessions",
              "required_regressed_sessions",
              "affected_domains",
              "affected_focus",
              "missing_runtime_facts",
              "failure_codes",
              "narratives"
            ],
            "properties": {
              "changed": {
                "type": "boolean"
              },
              "regressed_sessions": {
                "$ref": "#/$defs/stringArray"
              },
              "required_regressed_sessions": {
                "$ref": "#/$defs/stringArray"
              },
              "affected_domains": {
                "$ref": "#/$defs/stringArray"
              },
              "affected_focus": {
                "$ref": "#/$defs/stringArray"
              },
              "missing_runtime_facts": {
                "$ref": "#/$defs/stringArray"
              },
              "failure_codes": {
                "$ref": "#/$defs/stringArray"
              },
              "narratives": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        }
      ]
    },
    "worldCompareCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "world_verdict",
        "regression_count",
        "required_regression_count",
        "session_drift"
      ],
      "properties": {
        "result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ok",
            "fail",
            null
          ]
        },
        "world_verdict": {
          "$ref": "#/$defs/nullableString"
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "session_drift": {
          "$ref": "#/$defs/sessionDrift"
        }
      }
    },
    "witnessFailureExportCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "world_verdict",
        "regression_count",
        "required_regression_count",
        "candidate_session_status",
        "session_drift"
      ],
      "properties": {
        "result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ok",
            "fail",
            null
          ]
        },
        "world_verdict": {
          "$ref": "#/$defs/nullableString"
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_session_status": {
          "$ref": "#/$defs/nullableString"
        },
        "session_drift": {
          "$ref": "#/$defs/sessionDrift"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "world_compare_session_drift",
        "witness_session_failure_export"
      ],
      "properties": {
        "session": {
          "$ref": "#/$defs/sessionCheck"
        },
        "world_compare_session_drift": {
          "$ref": "#/$defs/worldCompareCheck"
        },
        "witness_session_failure_export": {
          "$ref": "#/$defs/witnessFailureExportCheck"
        }
      }
    }
  }
}
