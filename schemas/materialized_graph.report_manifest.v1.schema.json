{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/materialized_graph.report_manifest.v1.schema.json",
  "title": "materialized_graph.report_manifest/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "title",
    "format",
    "include_unchanged",
    "left",
    "right",
    "diff",
    "reports",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "materialized_graph.report_manifest/v1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "html",
        "both"
      ]
    },
    "include_unchanged": {
      "type": "boolean"
    },
    "left": {
      "$ref": "#/$defs/bundleRef"
    },
    "right": {
      "$ref": "#/$defs/bundleRef"
    },
    "diff": {
      "$ref": "#/$defs/diffSummary"
    },
    "reports": {
      "$ref": "#/$defs/reports"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseSummary"
      }
    }
  },
  "$defs": {
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "bundle_root"
      ],
      "properties": {
        "index": {
          "type": "string"
        },
        "bundle_root": {
          "type": "string"
        },
        "input_manifest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/inputManifest"
            }
          ]
        }
      }
    },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "added",
        "removed",
        "unchanged"
      ],
      "properties": {
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diffSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "case_count",
        "status_counts"
      ],
      "properties": {
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "$ref": "#/$defs/statusCounts"
        }
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "markdown",
        "html"
      ],
      "properties": {
        "manifest": {
          "type": "string"
        },
        "markdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "html": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "caseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "summary_changes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "changed",
            "added",
            "removed",
            "unchanged"
          ]
        },
        "summary_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
