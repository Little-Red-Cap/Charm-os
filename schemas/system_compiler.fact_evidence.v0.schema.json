{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.fact_evidence.v0.schema.json",
  "title": "system_compiler.fact_evidence/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "producer",
    "facts"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.fact_evidence/v0"
    },
    "source": {
      "type": "string"
    },
    "producer": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_facts",
        "required_facts",
        "audit_provided_facts"
      ],
      "properties": {
        "declared_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "required_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "audit_provided_facts": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "raw_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
