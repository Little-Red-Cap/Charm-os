{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/materialized_graph.ci_summary.v1.schema.json",
  "title": "materialized_graph.ci_summary/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at_utc",
    "output_root",
    "subject_defaults",
    "case_selection",
    "candidate",
    "baseline",
    "diff",
    "report",
    "artifact_report",
    "mode",
    "has_diff",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "materialized_graph.ci_summary/v1"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "output_root": {
      "type": "string"
    },
    "subject_defaults": {
      "$ref": "#/$defs/subjectDefaults"
    },
    "case_selection": {
      "$ref": "#/$defs/caseSelection"
    },
    "candidate": {
      "$ref": "#/$defs/bundleRef"
    },
    "baseline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/bundleRef"
        }
      ]
    },
    "diff": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/diffSummary"
        }
      ]
    },
    "report": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/reportSummary"
        }
      ]
    },
    "artifact_report": {
      "$ref": "#/$defs/artifactReportSummary"
    },
    "mode": {
      "type": "string",
      "enum": [
        "export_only",
        "compare"
      ]
    },
    "has_diff": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "exported",
        "same",
        "different"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "export_only"
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "type": "null"
          },
          "diff": {
            "type": "null"
          },
          "report": {
            "type": "null"
          },
          "status": {
            "const": "exported"
          },
          "has_diff": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "compare"
          }
        }
      },
      "then": {
        "properties": {
          "baseline": {
            "$ref": "#/$defs/bundleRef"
          },
          "diff": {
            "$ref": "#/$defs/diffSummary"
          },
          "report": {
            "$ref": "#/$defs/reportSummary"
          },
          "status": {
            "enum": [
              "same",
              "different"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_root",
        "index",
        "graph_aggregate"
      ],
      "properties": {
        "bundle_root": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "input_manifest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/inputManifest"
            }
          ]
        },
        "declared_facts_defaults": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stringArray"
            }
          ]
        },
        "declared_contracts_defaults": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resourceContractClause"
              }
            }
          ]
        },
        "graph_aggregate": {
          "$ref": "#/$defs/graphAggregate"
        }
      }
    },
    "resourceContractClause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "requires"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "enum": [
            "may_block",
            "needs_heap",
            "needs_reactor",
            "needs_monotonic_clock",
            "irq_safe"
          ]
        },
        "requires": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "countMap": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "graphAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "node_count",
        "edge_count",
        "connection_case_count"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "edge_count": {
          "type": "integer",
          "minimum": 0
        },
        "connection_case_count": {
          "type": "integer",
          "minimum": 0
        },
        "node_kinds": {
          "$ref": "#/$defs/countMap"
        },
        "connection_modes": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "caseSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_cases",
        "cases"
      ],
      "properties": {
        "all_cases": {
          "type": "boolean"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "subjectDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "board": {
          "type": [
            "string",
            "null"
          ]
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "added",
        "removed",
        "unchanged"
      ],
      "properties": {
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diffSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json",
        "case_count",
        "include_unchanged",
        "status_counts",
        "changed_cases",
        "added_cases",
        "removed_cases",
        "unchanged_cases",
        "metadata_changed_cases"
      ],
      "properties": {
        "json": {
          "type": "string"
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "include_unchanged": {
          "type": "boolean"
        },
        "status_counts": {
          "$ref": "#/$defs/statusCounts"
        },
        "changed_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "added_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "unchanged_cases": {
          "$ref": "#/$defs/stringArray"
        },
        "metadata_changed_cases": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "reportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "manifest",
        "markdown",
        "html"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "markdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "html": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifactReportCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "artifactReportSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_root",
        "index",
        "count",
        "compiler_headline",
        "cases"
      ],
      "properties": {
        "output_root": {
          "type": "string"
        },
        "index": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "compiler_headline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "https://charm-os.local/schemas/system_compiler.artifact_report_index.v0.schema.json#/$defs/compilerHeadline"
            }
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactReportCase"
          }
        }
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
