      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "projection_kind",
        "source_summary_schema",
        "source_summary_kind",
        "source_summary_path",
        "headline",
        "summary_lines",
        "question_lines",
        "supporting_summary_paths",
        "evidence_paths",
        "compare_paths",
        "blockers"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "projection_kind": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_kind": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "summary_lines": {
