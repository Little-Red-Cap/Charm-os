      "properties": {
        "id": {
          "type": "string"
        },
        "route_kind": {
          "type": "string",
          "enum": [
            "front_page_route_root"
          ]
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_input_summary_path": {
          "type": "string"
        },
        "source_root_summary_path": {
          "type": "string"
        },
        "source_report_markdown_path": {
          "type": "string"
        },
        "source_check_text_path": {
          "type": "string"
        },
        "level1_surface_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_route_summary_path",
        "output_root",
        "capability_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "input_route_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "capability_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "rootSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "label",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path"
      ],
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        }
      }
    },
    "entryStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_result",
        "recommended_entry_mode",
        "entry_tier",
        "root_summary_schema",
        "root_summary_kind",
        "root_label",
        "level1_surface_ids",
        "level1_roles",
        "unique_surface_count",
        "unique_role_count",
        "available_capability_count",
        "missing_capability_count",
        "route_entry_count",
        "route_provenance_entry_count",
        "route_provenance_owner_count",
        "repeated_entry_count",
        "cycle_entry_count",
        "expanded_entry_count",
        "max_depth"
      ],
      "properties": {
        "route_result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "recommended_entry_mode": {
          "type": "string",
          "enum": [
            "review",
            "compare",
            "biography",
            "evidence",
            "route"
          ]
        },
        "entry_tier": {
          "type": "string",
          "enum": [
            "review_ready",
            "compare_ready",
            "biography_ready",
            "evidence_only",
            "route_only"
          ]
        },
        "root_summary_schema": {
          "type": "string"
        },
        "root_summary_kind": {
          "type": "string"
        },
        "root_label": {
          "type": "string"
        },
        "level1_surface_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "level1_roles": {
          "$ref": "#/$defs/stringArray"
        },
        "unique_surface_count": {
          "type": "integer",
          "minimum": 0
        },
        "unique_role_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_capability_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_capability_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_provenance_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_provenance_owner_count": {
          "type": "integer",
          "minimum": 0
        },
        "repeated_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "cycle_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "expanded_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0
        }
      }
