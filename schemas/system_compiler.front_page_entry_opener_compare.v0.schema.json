{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opener_compare.v0.schema.json",
  "title": "system_compiler.front_page_entry_opener_compare/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "entry_opener_compare",
    "front_page",
    "opener_provenance",
    "artifact_context",
    "opener_verdict",
    "opener_status",
    "opener_changes",
    "change_summary",
    "field_changes",
    "opener_regression_surface",
    "opener_improvement_surface",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opener_compare/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opener_compare"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "entry_opener_compare": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "opener_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openerProvenanceEntry"
      }
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "opener_verdict": {
      "type": "string",
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed"
      ]
    },
    "opener_status": {
      "$ref": "#/$defs/openerStatus"
    },
    "opener_changes": {
      "$ref": "#/$defs/openerChanges"
    },
    "change_summary": {
      "$ref": "#/$defs/changeSummary"
    },
    "field_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldChange"
      }
    },
    "opener_regression_surface": {
      "$ref": "#/$defs/surface"
    },
    "opener_improvement_surface": {
      "$ref": "#/$defs/surface"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "openerProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "opener_role",
        "source_summary_schema",
        "source_summary_path",
        "source_report_markdown_path",
        "source_check_text_path",
        "result",
        "open_action_status",
        "selected_tab_id",
        "projection_kind",
        "compare_context_available",
        "inspector_ready"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "opener_role": {
          "type": "string",
          "enum": [
            "baseline_opener",
            "candidate_opener"
          ]
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_report_markdown_path": {
          "type": "string"
        },
        "source_check_text_path": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "open_action_status": {
          "type": "string"
        },
        "selected_tab_id": {
          "type": "string"
        },
        "projection_kind": {
          "type": "string"
        },
        "compare_context_available": {
          "type": "boolean"
        },
        "inspector_ready": {
          "type": "boolean"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_opener_summary_path",
        "candidate_opener_summary_path",
        "output_root",
        "compare_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "baseline_opener_summary_path": {
          "type": "string"
        },
        "candidate_opener_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "compare_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_result",
        "candidate_result",
        "baseline_open_action_status",
        "candidate_open_action_status",
        "baseline_selected_tab_id",
        "candidate_selected_tab_id",
        "baseline_query_kind",
        "candidate_query_kind",
        "baseline_query_scope",
        "candidate_query_scope",
        "baseline_target_summary_schema",
        "candidate_target_summary_schema",
        "baseline_target_summary_kind",
        "candidate_target_summary_kind",
        "baseline_projection_status",
        "candidate_projection_status",
        "baseline_projection_kind",
        "candidate_projection_kind",
        "baseline_compare_context_available",
        "candidate_compare_context_available",
        "baseline_landing_verdict",
        "candidate_landing_verdict",
        "baseline_inspector_ready",
        "candidate_inspector_ready"
      ],
      "properties": {
        "baseline_result": {
          "type": "string"
        },
        "candidate_result": {
          "type": "string"
        },
        "baseline_open_action_status": {
          "type": "string"
        },
        "candidate_open_action_status": {
          "type": "string"
        },
        "baseline_selected_tab_id": {
          "type": "string"
        },
        "candidate_selected_tab_id": {
          "type": "string"
        },
        "baseline_query_kind": {
          "type": "string"
        },
        "candidate_query_kind": {
          "type": "string"
        },
        "baseline_query_scope": {
          "type": "string"
        },
        "candidate_query_scope": {
          "type": "string"
        },
        "baseline_target_summary_schema": {
          "type": "string"
        },
        "candidate_target_summary_schema": {
          "type": "string"
        },
        "baseline_target_summary_kind": {
          "type": "string"
        },
        "candidate_target_summary_kind": {
          "type": "string"
        },
        "baseline_projection_status": {
          "type": "string"
        },
        "candidate_projection_status": {
          "type": "string"
        },
        "baseline_projection_kind": {
          "type": "string"
        },
        "candidate_projection_kind": {
          "type": "string"
        },
        "baseline_compare_context_available": {
          "type": "boolean"
        },
        "candidate_compare_context_available": {
          "type": "boolean"
        },
        "baseline_landing_verdict": {
          "type": "string"
        },
        "candidate_landing_verdict": {
          "type": "string"
        },
        "baseline_inspector_ready": {
          "type": "boolean"
        },
        "candidate_inspector_ready": {
          "type": "boolean"
        }
      }
    },
    "openerChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_changed",
        "open_action_status_changed",
        "selected_tab_changed",
        "query_changed",
        "target_changed",
        "projection_changed",
        "compare_context_changed",
        "inspector_ready_changed",
        "question_changed",
        "changed"
      ],
      "properties": {
        "result_changed": {
          "type": "boolean"
        },
        "open_action_status_changed": {
          "type": "boolean"
        },
        "selected_tab_changed": {
          "type": "boolean"
        },
        "query_changed": {
          "type": "boolean"
        },
        "target_changed": {
          "type": "boolean"
        },
        "projection_changed": {
          "type": "boolean"
        },
        "compare_context_changed": {
          "type": "boolean"
        },
        "inspector_ready_changed": {
          "type": "boolean"
        },
        "question_changed": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "changeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_field_count",
        "opening_field_changed_count",
        "projection_field_changed_count",
        "compare_context_field_changed_count",
        "inspector_field_changed_count",
        "question_field_changed_count",
        "regression_count",
        "improvement_count",
        "neutral_change_count"
      ],
      "properties": {
        "changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "opening_field_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "projection_field_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_context_field_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "inspector_field_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "question_field_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "improvement_count": {
          "type": "integer",
          "minimum": 0
        },
        "neutral_change_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fieldChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "group",
        "impact",
        "baseline_value",
        "candidate_value"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "group": {
          "type": "string",
          "enum": [
            "opening",
            "projection",
            "compare_context",
            "inspector",
            "questions"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "regression",
            "improvement",
            "neutral"
          ]
        },
        "baseline_value": {
          "type": "string"
        },
        "candidate_value": {
          "type": "string"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "affected_fields",
        "narratives"
      ],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "affected_fields": {
          "$ref": "#/$defs/stringArray"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
