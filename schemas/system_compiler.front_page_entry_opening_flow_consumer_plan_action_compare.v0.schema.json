        "opener_changed": {
          "type": "boolean"
        },
        "opening_reason_changed": {
          "type": "boolean"
        },
        "projection_headline_changed": {
          "type": "boolean"
        },
        "projection_summary_changed": {
          "type": "boolean"
        },
        "projection_questions_changed": {
          "type": "boolean"
        },
        "reason_changed": {
          "type": "boolean"
        },
        "operation_changed": {
          "type": "boolean"
        },
        "lost_compare_context": {
          "type": "boolean"
        },
        "lost_inspector_ready": {
          "type": "boolean"
        },
        "opener_surface_lost": {
          "type": "boolean"
        },
        "blockers_added": {
          "type": "boolean"
        },
