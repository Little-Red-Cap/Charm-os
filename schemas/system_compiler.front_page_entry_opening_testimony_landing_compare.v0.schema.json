        "result_changed": {
          "type": "boolean"
        },
        "landing_status_changed": {
          "type": "boolean"
        },
        "landing_collapsed": {
          "type": "boolean"
        },
        "landing_recovered": {
          "type": "boolean"
        },
        "selected_entry_changed": {
          "type": "boolean"
        },
        "selected_tab_changed": {
          "type": "boolean"
        },
        "selected_role_changed": {
          "type": "boolean"
        },
        "source_open_event_changed": {
          "type": "boolean"
        },
        "source_judgment_changed": {
          "type": "boolean"
        },
        "source_witness_status_changed": {
          "type": "boolean"
        },
        "preview_changed": {
          "type": "boolean"
        },
        "evidence_refs_changed": {
          "type": "boolean"
        },
        "witness_artifact_refs_changed": {
          "type": "boolean"
        },
        "next_questions_changed": {
          "type": "boolean"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
