{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.canonical_world.v0.schema.json",
  "title": "system_compiler.canonical_world/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "name",
    "title",
    "summary",
    "subject",
    "first_class_terms",
    "core_questions",
    "compare_questions",
    "contract_refs",
    "witness_plan"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.canonical_world/v0"
    },
    "kind": {
      "const": "system_compiler.canonical_world"
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/subjectSummary"
    },
    "first_class_terms": {
      "$ref": "#/$defs/stringArray"
    },
    "core_questions": {
      "$ref": "#/$defs/stringArray"
    },
    "compare_questions": {
      "$ref": "#/$defs/stringArray"
    },
    "contract_refs": {
      "$ref": "#/$defs/stringArray"
    },
    "witness_plan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witnessPlanEntry"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subjectSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "witnessKind": {
      "type": "string",
      "enum": [
        "artifact_report",
        "runtime_evidence_bundle",
        "example_ref"
      ]
    },
    "witnessPlanEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "role",
        "layer",
        "required",
        "witness_focus",
        "case",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/witnessKind"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "witness_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "case": {
          "$ref": "#/$defs/nullableString"
        },
        "path": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
