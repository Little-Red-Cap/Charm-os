    struct IconEntry {
        const char* name{nullptr};
        const gui::Image1bpp* image{nullptr};
    };

    inline const IconEntry kIcons[] = {
        {"Settings", &kSettingsIcon},
        {"AddV", &kAddVIcon},
        {"AddV2", &kAddV2Icon},
        {"Bipan", &kBipanIcon},
        {"Humiture", &kHumitureIcon},
        {"Game", &kGameIcon},
        {"Music", &kMusicIcon},
        {"Video", &kVideoIcon},
        {"Settings2", &kSettings2Icon},
        {"QRCode", &kQrCodeIcon},
        {"Calc", &kCalcIcon},
        {"Flash", &kFlashlightIcon},
        {"Second", &kSecondIcon},
    };

    [[nodiscard]] inline std::int16_t icon_count() noexcept
    {
        return (std::int16_t)(sizeof(kIcons) / sizeof(kIcons[0]));
    }

    
[[nodiscard]] inline const IconEntry& icon_at(std::int16_t index) noexcept
    {
        const std::int16_t count = icon_count();
        if (count <= 0) return kIcons[0];
        if (index < 0) index = 0;
        if (index >= count) index = (std::int16_t)(count - 1);
        return kIcons[index];
    }

    template <class R>
    void draw_icon(R& r, std::int16_t x, std::int16_t y, const IconEntry& icon, bool on = true) noexcept
    {
        if (!icon.image) return;
        gui::draw_image_1bpp(r, x, y, *icon.image, on);
    }
} // namespace app::icons
