{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/minimal_kernel.runtime_session_witness_inspect_compare.v0.schema.json",
  "title": "minimal_kernel.runtime_session_witness_inspect_compare/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at",
    "result",
    "artifact_context",
    "current",
    "comparison"
  ],
  "properties": {
    "schema": {
      "const": "minimal_kernel.runtime_session_witness_inspect_compare/v0"
    },
    "kind": {
      "const": "minimal_kernel.runtime_session_witness_inspect_compare"
    },
    "generated_at": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "current": {
      "$ref": "#/$defs/currentSummary"
    },
    "comparison": {
      "$ref": "#/$defs/comparisonSummary"
    }
  },
  "$defs": {
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "trap",
        "thread",
        "task_syscall",
        "handoff_continuity"
      ],
      "properties": {
        "tick": {
          "type": "boolean"
        },
        "trap": {
          "type": "boolean"
        },
        "thread": {
          "type": "boolean"
        },
        "task_syscall": {
          "type": "boolean"
        },
        "handoff_continuity": {
          "type": "boolean"
        }
      }
    },
    "sessionView": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "world",
              "session_status",
              "failure_domain",
              "failure_count",
              "ledger_event_count",
              "runtime"
            ],
            "properties": {
              "session_id": {
                "type": "string"
              },
              "world": {
                "type": "string"
              },
              "session_status": {
                "type": "string"
              },
              "failure_domain": {
                "$ref": "#/$defs/nullableString"
              },
              "failure_count": {
                "type": "integer",
                "minimum": 0
              },
              "ledger_event_count": {
                "type": "integer",
                "minimum": 0
              },
              "runtime": {
                "$ref": "#/$defs/runtimeFacts"
              }
            }
          }
        }
      ]
    },
    "sessionDriftView": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "changed",
              "regressed_sessions",
              "required_regressed_sessions",
              "affected_domains",
              "affected_focus",
              "missing_runtime_facts",
              "failure_codes",
              "narratives"
            ],
            "properties": {
              "changed": {
                "type": "boolean"
              },
              "regressed_sessions": {
                "$ref": "#/$defs/stringArray"
              },
              "required_regressed_sessions": {
                "$ref": "#/$defs/stringArray"
              },
              "affected_domains": {
                "$ref": "#/$defs/stringArray"
              },
              "affected_focus": {
                "$ref": "#/$defs/stringArray"
              },
              "missing_runtime_facts": {
                "$ref": "#/$defs/stringArray"
              },
              "failure_codes": {
                "$ref": "#/$defs/stringArray"
              },
              "narratives": {
                "$ref": "#/$defs/stringArray"
              }
            }
          }
        }
      ]
    },
    "compareCheckView": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "world_verdict",
              "regression_count",
              "required_regression_count",
              "session_drift"
            ],
            "properties": {
              "result": {
                "$ref": "#/$defs/nullableString"
              },
              "world_verdict": {
                "$ref": "#/$defs/nullableString"
              },
              "regression_count": {
                "type": "integer",
                "minimum": 0
              },
              "required_regression_count": {
                "type": "integer",
                "minimum": 0
              },
              "candidate_session_status": {
                "$ref": "#/$defs/nullableString"
              },
              "session_drift": {
                "$ref": "#/$defs/sessionDriftView"
              }
            }
          }
        }
      ]
    },
    "artifactsView": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary",
              "report_markdown",
              "check_text",
              "session",
              "world_compare_session_drift",
              "witness_session_failure_export"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "report_markdown": {
                "type": "string"
              },
              "check_text": {
                "type": "string"
              },
              "session": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "output_root",
                  "summary",
                  "runtime_ledger",
                  "report_markdown",
                  "check_text"
                ],
                "properties": {
                  "output_root": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "runtime_ledger": {
                    "type": "string"
                  },
                  "report_markdown": {
                    "type": "string"
                  },
                  "check_text": {
                    "type": "string"
                  }
                }
              },
              "world_compare_session_drift": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "output_root",
                  "summary",
                  "report_markdown",
                  "check_text"
                ],
                "properties": {
                  "output_root": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "report_markdown": {
                    "type": "string"
                  },
                  "check_text": {
                    "type": "string"
                  }
                }
              },
              "witness_session_failure_export": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "output_root",
                  "baseline_summary",
                  "candidate_summary",
                  "world_compare_summary",
                  "world_compare_report_markdown",
                  "world_compare_check_text"
                ],
                "properties": {
                  "output_root": {
                    "type": "string"
                  },
                  "baseline_summary": {
                    "type": "string"
                  },
                  "candidate_summary": {
                    "type": "string"
                  },
                  "world_compare_summary": {
                    "type": "string"
                  },
                  "world_compare_report_markdown": {
                    "type": "string"
                  },
                  "world_compare_check_text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "currentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "result",
        "output_root",
        "session",
        "world_compare_session_drift",
        "witness_session_failure_export",
        "violations",
        "artifacts"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "output_root": {
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/sessionView"
        },
        "world_compare_session_drift": {
          "$ref": "#/$defs/compareCheckView"
        },
        "witness_session_failure_export": {
          "$ref": "#/$defs/compareCheckView"
        },
        "violations": {
          "$ref": "#/$defs/stringArray"
        },
        "artifacts": {
          "$ref": "#/$defs/artifactsView"
        }
      }
    },
    "scalarCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "baseline",
        "changed"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/nullableString"
        },
        "baseline": {
          "$ref": "#/$defs/nullableString"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "arrayDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "$ref": "#/$defs/stringArray"
        },
        "removed": {
          "$ref": "#/$defs/stringArray"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "runtimeDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regressed",
        "improved",
        "changed"
      ],
      "properties": {
        "regressed": {
          "$ref": "#/$defs/stringArray"
        },
        "improved": {
          "$ref": "#/$defs/stringArray"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "boolCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "baseline",
        "changed"
      ],
      "properties": {
        "current": {
          "type": "boolean"
        },
        "baseline": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "comparisonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "baseline_summary_path",
        "changed",
        "result",
        "session",
        "world_compare_session_drift",
        "witness_session_failure_export",
        "violations"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "baseline_summary_path": {
          "type": "string"
        },
        "changed": {
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/scalarCompare"
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "failure_domain",
            "failure_count_delta",
            "ledger_event_count_delta",
            "runtime"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/scalarCompare"
            },
            "failure_domain": {
              "$ref": "#/$defs/scalarCompare"
            },
            "failure_count_delta": {
              "type": "integer"
            },
            "ledger_event_count_delta": {
              "type": "integer"
            },
            "runtime": {
              "$ref": "#/$defs/runtimeDelta"
            }
          }
        },
        "world_compare_session_drift": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "changed_flag",
            "failure_codes",
            "missing_runtime_facts",
            "affected_focus"
          ],
          "properties": {
            "verdict": {
              "$ref": "#/$defs/scalarCompare"
            },
            "changed_flag": {
              "$ref": "#/$defs/boolCompare"
            },
            "failure_codes": {
              "$ref": "#/$defs/arrayDelta"
            },
            "missing_runtime_facts": {
              "$ref": "#/$defs/arrayDelta"
            },
            "affected_focus": {
              "$ref": "#/$defs/arrayDelta"
            }
          }
        },
        "witness_session_failure_export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "candidate_session_status",
            "changed_flag",
            "failure_codes",
            "missing_runtime_facts",
            "affected_focus"
          ],
          "properties": {
            "verdict": {
              "$ref": "#/$defs/scalarCompare"
            },
            "candidate_session_status": {
              "$ref": "#/$defs/scalarCompare"
            },
            "changed_flag": {
              "$ref": "#/$defs/boolCompare"
            },
            "failure_codes": {
              "$ref": "#/$defs/arrayDelta"
            },
            "missing_runtime_facts": {
              "$ref": "#/$defs/arrayDelta"
            },
            "affected_focus": {
              "$ref": "#/$defs/arrayDelta"
            }
          }
        },
        "violations": {
          "$ref": "#/$defs/arrayDelta"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "baseline_summary_path",
        "compare_summary_path",
        "output_root"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "baseline_summary_path": {
          "type": "string"
        },
        "compare_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        }
      }
    }
  }
}
