{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_flow_open_event_witness.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_flow_open_event_witness/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_flow_open_event_witness",
    "front_page",
    "artifact_context",
    "open_event_identity",
    "judgment",
    "witness_entry",
    "evidence_refs",
    "explanation",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_flow_open_event_witness/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_flow_open_event_witness"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/okFailResult"
    },
    "opening_flow_open_event_witness": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "open_event_identity": {
      "$ref": "#/$defs/openEventIdentity"
    },
    "judgment": {
      "$ref": "#/$defs/judgment"
    },
    "witness_entry": {
      "$ref": "#/$defs/witnessEntry"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      }
    },
    "explanation": {
      "$ref": "#/$defs/explanation"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "okFailResult": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "openEventStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "accepted_with_drift",
        "blocked"
      ]
    },
    "compareVerdictOrNotAttached": {
      "type": "string",
      "enum": [
        "standing",
        "improved",
        "drifted",
        "collapsed",
        "not_attached"
      ]
    },
    "judgmentGrade": {
      "type": "string",
      "enum": [
        "described",
        "compared"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_open_event_summary_path",
        "source_open_event_report_markdown_path",
        "source_open_event_check_text_path",
        "output_root",
        "open_event_witness_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_open_event_summary_path": {
          "type": "string"
        },
        "source_open_event_report_markdown_path": {
          "type": "string"
        },
        "source_open_event_check_text_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "open_event_witness_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openEventIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_event_id",
        "open_event_status",
        "open_event_result",
        "reason_kind",
        "reason_summary",
        "source_summary_schema",
        "source_summary_kind",
        "source_summary_path"
      ],
      "properties": {
        "open_event_id": {
          "type": "string"
        },
        "open_event_status": {
          "$ref": "#/$defs/openEventStatus"
        },
        "open_event_result": {
          "$ref": "#/$defs/okFailResult"
        },
        "reason_kind": {
          "type": "string"
        },
        "reason_summary": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_kind": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_id",
        "witness_status",
        "accepted",
        "source_judgment_status",
        "source_judgment_grade",
        "source_judgment_basis",
        "source_judgment_summary",
        "selected_consumer_id",
        "selected_action_id",
        "candidate_consumer_count",
        "rejected_consumer_count",
        "compare_available",
        "compare_verdict",
        "compare_changed_field_count",
        "workspace_facade_status",
        "workspace_facade_kind",
        "evidence_ref_count",
        "artifact_ref_count"
      ],
      "properties": {
        "witness_id": {
          "type": "string"
        },
        "witness_status": {
          "$ref": "#/$defs/okFailResult"
        },
        "accepted": {
          "type": "boolean"
        },
        "source_judgment_status": {
          "$ref": "#/$defs/openEventStatus"
        },
        "source_judgment_grade": {
          "$ref": "#/$defs/judgmentGrade"
        },
        "source_judgment_basis": {
          "$ref": "#/$defs/stringArray"
        },
        "source_judgment_summary": {
          "type": "string"
        },
        "selected_consumer_id": {
          "type": "string"
        },
        "selected_action_id": {
          "type": "string"
        },
        "candidate_consumer_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_consumer_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_available": {
          "type": "boolean"
        },
        "compare_verdict": {
          "$ref": "#/$defs/compareVerdictOrNotAttached"
        },
        "compare_changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "workspace_facade_status": {
          "type": "string"
        },
        "workspace_facade_kind": {
          "type": "string"
        },
        "evidence_ref_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_ref_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entrySubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "profile",
        "board",
        "active_facets"
      ],
      "properties": {
        "case": {
          "$ref": "#/$defs/nullableString"
        },
        "profile": {
          "$ref": "#/$defs/nullableString"
        },
        "board": {
          "$ref": "#/$defs/nullableString"
        },
        "active_facets": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "witnessEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "role",
        "layer",
        "required",
        "status",
        "witness_focus",
        "case",
        "source_path",
        "subject",
        "observations",
        "artifact_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "open_event_witness"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "layer": {
          "const": "opening_flow"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/okFailResult"
        },
        "witness_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "case": {
          "$ref": "#/$defs/nullableString"
        },
        "source_path": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/entrySubject"
        },
        "observations": {
          "$ref": "#/$defs/stringArray"
        },
        "artifact_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openingInputObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "focus_kind": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "reason_kind": {
          "type": "string"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_kind",
        "why_opened",
        "chosen_consumer",
        "compare_result",
        "text_lines"
      ],
      "properties": {
        "view_kind": {
          "type": "string"
        },
        "why_opened": {
          "type": "string"
        },
        "chosen_consumer": {
          "type": "string"
        },
        "compare_result": {
          "type": "string"
        },
        "opening_input_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openingInputObservation"
          }
        },
        "text_lines": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "witness_questions",
        "next_questions"
      ],
      "properties": {
        "witness_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
