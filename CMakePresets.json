{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "aarch64-baremetal-base",
      "displayName": "AArch64 Bare-metal Base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/aarch64-baremetal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-none-elf-gcc.cmake",
        "CHARM_TARGET_ARCH": "aarch64",
        "CHARM_TARGET_PLATFORM": "qemu_virt",
        "CHARM_BAREMETAL": "ON",
        "CHARM_TARGET_HAS_HOSTED_CXX": "OFF",
        "CHARM_ENABLE_MEDIA": "OFF",
        "CHARM_ENABLE_UI_INK": "OFF",
        "CHARM_ENABLE_UI_VIVID": "OFF",
        "CHARM_ENABLE_SDL3": "OFF",
        "CHARM_ENABLE_FATFS": "OFF",
        "CHARM_AUDIO_USE_VFS": "OFF"
      }
    },
    {
      "name": "arm-none-eabi-base",
      "displayName": "ARM Cortex-M Bare-metal Base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/arm-none-eabi",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/arm-none-eabi-gcc.cmake",
        "CHARM_BAREMETAL": "ON",
        "CHARM_TARGET_HAS_HOSTED_CXX": "OFF"
      }
    },
    {
      "name": "rk3506-baremetal-base",
      "displayName": "RK3506 Bare-metal Base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-rk3506-baremetal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/armv7a-none-eabi-gcc.cmake",
        "CHARM_TARGET_NAME": "rk3506",
        "CHARM_ENABLE_MEDIA": "OFF",
        "CHARM_ENABLE_UI_INK": "OFF",
        "CHARM_ENABLE_UI_VIVID": "OFF",
        "CHARM_ENABLE_SDL3": "OFF",
        "CHARM_ENABLE_FATFS": "OFF",
        "CHARM_ENABLE_POSIX": "OFF",
        "CHARM_AUDIO_USE_VFS": "OFF",
        "CHARM_TARGET_HAS_HOSTED_CXX": "OFF",
        "CHARM_TARGET_HAS_CXX_MATH": "OFF",
        "CHARM_TARGET_HAS_WIN32": "OFF",
        "CHARM_TARGET_HAS_WINSOCK": "OFF",
        "CHARM_TARGET_STRICT_ALIGNMENT": "ON"
      }
    },
    {
      "name": "rk3506-baremetal-debug",
      "displayName": "RK3506 Bare-metal Debug",
      "inherits": "rk3506-baremetal-base"
    },
    {
      "name": "rk3506-baremetal-image-debug",
      "displayName": "RK3506 Bare-metal Image Debug",
      "inherits": "rk3506-baremetal-base",
      "binaryDir": "${sourceDir}/cmake-build-rk3506-baremetal-image",
      "cacheVariables": {
        "CHARM_BUILD_TARGET_BOOTSTRAP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "rk3506-baremetal-debug",
      "configurePreset": "rk3506-baremetal-debug"
    },
    {
      "name": "rk3506-baremetal-image-debug",
      "configurePreset": "rk3506-baremetal-image-debug"
    }
  ]
}
