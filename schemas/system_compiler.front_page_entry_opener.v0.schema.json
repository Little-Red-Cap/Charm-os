        "ready": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "report",
            "artifact_root",
            "unresolved"
          ]
        },
        "query_kind": {
          "type": "string"
        },
        "output_format": {
          "type": "string",
