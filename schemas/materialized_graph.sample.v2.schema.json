{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/materialized_graph.sample.v2.schema.json",
  "title": "materialized_graph.sample/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "effective_max_phase",
    "effective_runlevel_mask",
    "effective_runlevel_text",
    "node_count",
    "edge_count",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "const": "materialized_graph.sample/v2"
    },
    "effective_max_phase": {
      "$ref": "#/$defs/phase"
    },
    "effective_runlevel_mask": {
      "type": "integer",
      "minimum": 0
    },
    "effective_runlevel_text": {
      "type": "string"
    },
    "node_count": {
      "type": "integer",
      "minimum": 0
    },
    "edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "string",
      "enum": [
        "early",
        "core",
        "service",
        "app"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^0x[0-9A-F]+$"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "name",
        "kind",
        "phase",
        "runlevel_mask",
        "runlevel_text",
        "provides",
        "requires"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "recipe",
            "barrier",
            "legacy"
          ]
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "runlevel_mask": {
          "type": "integer",
          "minimum": 0
        },
        "runlevel_text": {
          "type": "string"
        },
        "provides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_index",
        "consumer_index",
        "capability"
      ],
      "properties": {
        "provider_index": {
          "type": "integer",
          "minimum": 0
        },
        "consumer_index": {
          "type": "integer",
          "minimum": 0
        },
        "capability": {
          "$ref": "#/$defs/capability"
        }
      }
    }
  }
}
