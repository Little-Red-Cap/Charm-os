        MODULE_GROUP_PRODUCT_FS)
elseif (PLAYER_PROFILE STREQUAL "USB_STORAGE")
    set(PLAYER_PROFILE_SOURCE app/main-usb-storage.cpp)
    set(PLAYER_PROFILE_COMPILE_DEFINITIONS
