        },
        "reason": {
          "type": "string"
        }
      }
    },
    "consumerDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_consumer",
        "candidate_consumers",
        "rejected_consumers",
        "candidate_consumer_count",
        "rejected_consumer_count",
        "decision_reason"
      ],
      "properties": {
        "selected_consumer": {
          "$ref": "#/$defs/selectedConsumer"
        },
        "candidate_consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidateConsumer"
          }
        },
        "rejected_consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejectedConsumer"
          }
        },
        "candidate_consumer_count": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_consumer_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_reason": {
          "type": "string"
        }
      }
    },
    "planSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "result",
        "execution_plan_status",
        "planned_action_count",
        "default_action_id",
        "compare_action_id",
        "selected_action_id"
      ],
