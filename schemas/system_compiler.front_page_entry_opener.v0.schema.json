        "tab_id": {
          "type": "string"
        },
        "tab_title": {
          "type": "string"
        },
        "entry_role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "report",
            "artifact_root"
          ]
        },
        "selection_rule": {
          "type": "string",
          "enum": [
            "single_report",
            "artifact_root_full",
            "artifact_root_or_subset"
          ]
        },
        "query_kind": {
          "type": "string",
          "enum": [
            "default_overview",
            "bringup_evidence",
            "resource_summary",
            "cap_list"
          ]
        },
        "compare_expected": {
          "type": "boolean"
        },
        "followup_query_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "sourceLandingCompare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_summary_path",
        "related_landing_role",
        "landing_verdict",
        "baseline_landing_summary_path",
        "candidate_landing_summary_path",
        "baseline_primary_tab_id",
        "candidate_primary_tab_id",
        "primary_query_changed",
        "landing_regression_changed",
        "query_regression_changed",
        "landing_regression_affected_tab_ids",
        "query_regression_affected_tab_ids",
        "narratives"
      ],
      "properties": {
        "source_summary_path": {
          "type": "string"
        },
        "related_landing_role": {
          "type": "string",
          "enum": [
            "baseline_landing",
            "candidate_landing"
          ]
        },
        "landing_verdict": {
          "type": "string",
          "enum": [
            "standing",
            "improved",
            "drifted",
            "collapsed"
          ]
