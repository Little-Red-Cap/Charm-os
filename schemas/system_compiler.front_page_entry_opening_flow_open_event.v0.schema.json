        "entry_name": {
          "type": "string"
        },
        "selected_role": {
          "type": "string"
        },
        "query_kind": {
          "type": "string"
        },
        "query_scope": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "projection_kind": {
          "type": "string"
        },
        "chosen_by": {
          "type": "string"
        }
      }
    },
    "candidateConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "action_id",
        "entry_name",
        "rank",
        "action_kind",
        "display_group",
        "projection_kind",
        "target_summary_schema",
        "target_summary_kind",
        "target_summary_path",
        "selected",
        "selection_basis"
      ],
      "properties": {
        "consumer_id": {
          "type": "string"
        },
        "action_id": {
          "type": "string"
        },
        "entry_name": {
          "type": "string"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "action_kind": {
          "type": "string"
        },
        "display_group": {
          "type": "string"
        },
        "projection_kind": {
          "type": "string"
        },
        "target_summary_schema": {
          "type": "string"
        },
        "target_summary_kind": {
          "type": "string"
        },
        "target_summary_path": {
          "type": "string"
        },
        "selected": {
          "type": "boolean"
        },
        "selection_basis": {
          "type": "string"
        }
      }
    },
    "rejectedConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_id",
        "action_id",
        "entry_name",
        "reason"
