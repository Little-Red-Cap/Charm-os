module;

#include <array>
#include <cstddef>
#include <cstdint>

#include "vivid_features.generated.hpp"

export module charm.core.config.generated;

export import charm.core.handle;
export import charm.gfx.pixel_format;

export namespace charm::vivid::config {
    enum class Featureset : std::uint8_t {
        full = 0,
        mcu_min = 1,
        product = 2,
    };

    enum class KernelMode : std::uint8_t {
        soa = 0,
    };

    struct ScreenConfig {
        int width;
        int height;
        PixelFormat pixel_format;
        int layer_cache_slots;
        int layer_cache_width;
        int layer_cache_height;
    };

    struct FeatureConfig {
        Featureset featureset;
        KernelMode kernel_mode;
        bool enable_float_widgets;
        bool draw_detail_evidence;
    };

    constexpr std::size_t kWidgetFeatureCount =
        static_cast<std::size_t>(WidgetKind::Histogram) + 1;

    struct WidgetFeatureTable {
        std::array<bool, kWidgetFeatureCount> enabled{};

        constexpr bool operator[](WidgetKind kind) const noexcept {
            const auto idx = static_cast<std::size_t>(kind);
            return idx < enabled.size() ? enabled[idx] : false;
        }
    };

    struct SoaConfig {
        std::size_t max_nodes;
    };

    struct StyleConfig {
        std::size_t style_class_max;
        std::size_t style_rule_cap;
        std::size_t style_metrics_pool_cap;
    };

    struct DrawCmdConfig {
        std::size_t max_commands;
        std::size_t text_bytes;
        std::size_t blob_bytes;
    };

    struct VividConfig {
        ScreenConfig screen;
        FeatureConfig features;
        SoaConfig soa;
        StyleConfig style;
        DrawCmdConfig draw_cmd;
    };

    inline constexpr VividConfig kConfig{
        ScreenConfig{
            @VIVID_SCREEN_WIDTH@,
            @VIVID_SCREEN_HEIGHT@,
            @VIVID_SCREEN_PIXEL_FORMAT@,
            @VIVID_LAYER_CACHE_SLOTS@,
            @VIVID_LAYER_CACHE_WIDTH@,
            @VIVID_LAYER_CACHE_HEIGHT@
        },
        FeatureConfig{
            Featureset::@VIVID_FEATURESET_ENUM@,
            KernelMode::soa,
            @VIVID_ENABLE_FLOAT_WIDGETS@,
            @VIVID_DRAW_DETAIL_EVIDENCE@
        },
        SoaConfig{
            @VIVID_SOA_MAX_NODES@
        },
        StyleConfig{
            @VIVID_STYLE_CLASS_MAX@,
            @VIVID_STYLE_RULE_CAP@,
            @VIVID_STYLE_METRICS_POOL_CAP@
        },
        DrawCmdConfig{
            @VIVID_DRAW_CMD_MAX_COMMANDS@,
            @VIVID_DRAW_CMD_TEXT_BYTES@,
            @VIVID_DRAW_CMD_BLOB_BYTES@
        }
    };

    inline constexpr ScreenConfig kScreen = kConfig.screen;
    inline constexpr FeatureConfig kFeatures = kConfig.features;
    inline constexpr SoaConfig kSoa = kConfig.soa;
    inline constexpr StyleConfig kStyle = kConfig.style;
    inline constexpr DrawCmdConfig kDrawCmd = kConfig.draw_cmd;
    inline constexpr WidgetFeatureTable kWidgetFeatures = []() {
        WidgetFeatureTable table{};
#define VIVID_WIDGET_REGISTRY(name, module_tag, cpp_type, theme_base_kind, factory_fn, factory_pool, factory_create, payload_on, payload_kind, style_mask, hit_test_false, focusable, clip_children, layout_list, click_on, click_behavior, click_index, group_kind, checkable, scroll_on, wheel_target, drag_behavior, drag_on, drag_behavior_only, wheel_on, wheel_target_only, extra_on, scroll_axis, wheel_axis, capture_on) \
        table.enabled[static_cast<std::size_t>(WidgetKind::name)] = (CHARM_VIVID_ENABLE_WIDGET_##name != 0);
#include "widgets.registry.def"
#undef VIVID_WIDGET_REGISTRY
        return table;
    }();

    static_assert(kScreen.width > 0);
    static_assert(kScreen.height > 0);
    static_assert(kScreen.layer_cache_slots > 0);
    static_assert(kScreen.layer_cache_width > 0);
    static_assert(kScreen.layer_cache_height > 0);
    static_assert(kSoa.max_nodes > 0);
    static_assert(kStyle.style_class_max > 0);
    static_assert(kStyle.style_class_max <= 65535);
    static_assert(kStyle.style_rule_cap > 0);
    static_assert(kStyle.style_rule_cap <= 65535);
    static_assert(kStyle.style_metrics_pool_cap > 0);
    static_assert(kStyle.style_metrics_pool_cap <= 255);
    static_assert(kDrawCmd.max_commands > 0);
    static_assert(kDrawCmd.text_bytes > 0);
    static_assert(kDrawCmd.blob_bytes > 0);

    constexpr bool widget_enabled(WidgetKind kind) noexcept {
        return kWidgetFeatures[kind];
    }
}

export using charm::vivid::config::Featureset;
export using charm::vivid::config::KernelMode;

export inline constexpr auto vivid_config = charm::vivid::config::kConfig;
export inline constexpr auto vivid_screen = charm::vivid::config::kScreen;
export inline constexpr auto vivid_features = charm::vivid::config::kFeatures;
export inline constexpr auto vivid_soa = charm::vivid::config::kSoa;
export inline constexpr auto vivid_style = charm::vivid::config::kStyle;
export inline constexpr auto vivid_draw_cmd = charm::vivid::config::kDrawCmd;
export inline constexpr auto vivid_widget_features = charm::vivid::config::kWidgetFeatures;

export inline constexpr auto vivid_featureset = vivid_config.features.featureset;
export inline constexpr auto vivid_kernel_mode = vivid_config.features.kernel_mode;

export inline constexpr int screen_width = vivid_config.screen.width;
export inline constexpr int screen_height = vivid_config.screen.height;
export inline constexpr PixelFormat screen_pixel_format = vivid_config.screen.pixel_format;
export inline constexpr int layer_cache_slots = vivid_config.screen.layer_cache_slots;
export inline constexpr int layer_cache_width = vivid_config.screen.layer_cache_width;
export inline constexpr int layer_cache_height = vivid_config.screen.layer_cache_height;
export inline constexpr bool enable_float_widgets = vivid_config.features.enable_float_widgets;
export inline constexpr bool draw_detail_evidence_enabled = vivid_config.features.draw_detail_evidence;
export inline constexpr std::size_t soa_max_nodes = vivid_config.soa.max_nodes;
export inline constexpr std::size_t style_class_max = vivid_config.style.style_class_max;
export inline constexpr std::size_t style_rule_cap = vivid_config.style.style_rule_cap;
export inline constexpr std::size_t style_metrics_pool_cap = vivid_config.style.style_metrics_pool_cap;
export inline constexpr bool vivid_is_mcu_min_featureset =
    vivid_config.features.featureset == Featureset::mcu_min;
export inline constexpr bool vivid_is_full_featureset =
    vivid_config.features.featureset == Featureset::full;
export inline constexpr bool vivid_is_product_featureset =
    vivid_config.features.featureset == Featureset::product;

export constexpr bool vivid_widget_feature_enabled(WidgetKind kind) noexcept {
    return charm::vivid::config::widget_enabled(kind);
}
