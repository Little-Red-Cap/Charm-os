{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_testimony_explain_entry.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_testimony_explain_entry/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_testimony_explain_entry",
    "front_page",
    "artifact_context",
    "source_route_ref",
    "explain_entry_decision",
    "selected_surface",
    "supporting_surfaces",
    "opening_reason",
    "next_questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_testimony_explain_entry/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_testimony_explain_entry"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_testimony_explain_entry": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "source_route_ref": {
      "$ref": "#/$defs/sourceRouteRef"
    },
    "explain_entry_decision": {
      "$ref": "#/$defs/explainEntryDecision"
    },
    "selected_surface": {
      "$ref": "#/$defs/explainSurface"
    },
    "supporting_surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/explainSurface"
      }
    },
    "opening_reason": {
      "$ref": "#/$defs/openingReason"
    },
    "next_questions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/typedQuestion"
      }
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_summary_path",
        "output_root",
        "explain_entry_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "explain_entry_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "sourceRouteRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "root_summary_schema",
        "route_verdict",
        "baseline_route_summary_path",
        "candidate_route_summary_path"
      ],
      "properties": {
        "summary_schema": {
          "type": "string",
          "enum": [
            "system_compiler.front_page_route/v0",
            "system_compiler.front_page_route_compare/v0"
          ]
        },
        "summary_kind": {
          "type": "string",
          "enum": [
            "system_compiler.front_page_route",
            "system_compiler.front_page_route_compare"
          ]
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "root_summary_schema": {
          "type": "string"
        },
        "route_verdict": {
          "type": "string"
        },
        "baseline_route_summary_path": {
          "type": "string"
        },
        "candidate_route_summary_path": {
          "type": "string"
        }
      }
    },
    "explainEntryDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selection_kind",
        "selected_entry_id",
        "selected_tab_id",
        "selected_role",
        "selected_source"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "selection_kind": {
          "type": "string",
          "enum": [
            "route_landing_default",
            "route_landing_compare_default",
            "route_explain_entry_compare_default",
            "route_handoff_compare_default",
            "route_world_shelf_review_default",
            "route_compare_candidate_root",
            "route_compare_candidate_change",
            "blocked"
          ]
        },
        "selected_entry_id": {
          "type": "string"
        },
        "selected_tab_id": {
          "type": "string",
          "const": "opening_testimony_explain"
        },
        "selected_role": {
          "type": "string",
          "const": "opening_testimony_explain_entry"
        },
        "selected_source": {
          "type": "string"
        }
      }
    },
    "explainSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "label",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "route_id",
        "depth",
        "source"
      ],
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "route_id": {
          "type": "string"
        },
        "depth": {
          "$ref": "#/$defs/nullableInteger"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "openingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "source_summary_path"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "route_default_explain_surface",
            "route_compare_default_explain_surface"
          ]
        },
        "summary": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        }
      }
    },
    "typedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "target_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inspect_selected_surface",
            "inspect_source_route",
            "inspect_supporting_surfaces"
          ]
        },
        "summary": {
          "type": "string"
        },
        "target_ref": {
          "type": "string"
        }
      }
    }
  }
}
