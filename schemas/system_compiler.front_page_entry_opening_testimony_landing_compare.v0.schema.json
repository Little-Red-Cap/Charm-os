      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
