module;
#include <algorithm>
#include <cstddef>
export module charm.widgets.text_area;
import charm.core.object;
import charm.gfx.color;
import charm.gfx.render;
import charm.core.event;
import charm.core.style;
import charm.widgets.text;
import charm.core.string;

using namespace ui::render;

export
class TextArea : public ObjectBase {
public:
    explicit TextArea(const char* text = "") : text_(text) {
        set_focusable(true);
        set_size(240, 120);
        cursor_ = static_cast<int>(text_.size());
    }

    void set_text(const char* t) {
        text_.assign(t);
        cursor_ = static_cast<int>(std::min<std::size_t>(text_.size(), StaticString<256>::max_size()));
    }

    const char* text() const noexcept { return text_.c_str(); }

    void set_readonly(bool on) noexcept { readonly_ = on; }
    bool is_readonly() const noexcept { return readonly_; }

    void draw(DefaultCanvas& cvs) override {
        const Style& st = Theme::instance().get<TextArea>();
        const auto r = get_rect();

        rgba bg{};
        rgba border{};
        rgba font{};
        resolve_colors(st,
                       {is_enabled(), has_state(State::Hovered), has_state(State::Pressed), has_state(State::Focused)},
                       bg, border, font);

        draw_rect(cvs, r.x, r.y, r.w, r.h, bg, true);
        draw_rect(cvs, r.x, r.y, r.w, r.h, border, false);

        const Rect inner{r.x + st.padding, r.y + st.padding,
                         r.w - st.padding * 2, r.h - st.padding * 2};
        auto clip_state = cvs.save_clip();
        cvs.set_clip(inner);
        Rect draw_box{inner.x, inner.y - scroll_y_px_, inner.w, inner.h + scroll_y_px_};
        draw_text_box(cvs, draw_box, text_.c_str(), font, resolve_font(st),
                      TextAlignH::Left, TextAlignV::Top, TextWrap::Word, TextEllipsis::None);

        // simple caret at end of text (approx): draw thin line at left + text width using mono assumption
        if (has_state(State::Focused)) {
            // approximate character width by font height * 0.55 to avoid full measurement dependency
            const int line_h = line_height(resolve_font(st));
            const float avg_w = line_h * 0.55f;
            int caret_x = inner.x + static_cast<int>(avg_w * cursor_col(inner.w, avg_w));
            int caret_y1 = inner.y + cursor_row() * line_h - scroll_y_px_;
            int caret_y2 = caret_y1 + line_h;
            caret_x = std::min(inner.x + inner.w - 2, std::max(inner.x + 1, caret_x));
            draw_line(cvs, caret_x, caret_y1, caret_x, caret_y2, st.border_focus);
        }

        if (has_state(State::Focused)) {
            draw_rect(cvs, r.x, r.y, r.w, r.h, st.border_focus, false);
        }
        cvs.restore_clip(clip_state);
    }

    bool on_event(const Event& e) override {
        if (!is_enabled()) return false;
        if (e.type == Event::Type::Click) {
            if (get_rect().contains(e.x, e.y) || has_state(State::Focused)) {
                return true;
            }
        }
        if (!readonly_) {
            if (e.type == Event::Type::KeyDown) {
                if (e.ch >= 32 && e.ch <= 126) {
                    insert_char(static_cast<char>(e.ch));
                    ensure_caret_visible();
                    return true;
                }
                switch (e.key_code) {
                case Event::Key::Backspace:
                    if (cursor_ > 0 && !text_.empty()) {
                        text_.erase(cursor_ - 1, 1);
                        --cursor_;
                        ensure_caret_visible();
                    }
                    return true;
                case Event::Key::Enter:
                    insert_char('\n');
                    ensure_caret_visible();
                    return true;
                case Event::Key::Space:
                    insert_char(' ');
                    ensure_caret_visible();
                    return true;
                case Event::Key::Left:
                    if (cursor_ > 0) --cursor_;
                    desired_col_ = cursor_col_cached();
                    ensure_caret_visible();
                    return true;
                case Event::Key::Right:
                    if (cursor_ < static_cast<int>(text_.size())) ++cursor_;
                    desired_col_ = cursor_col_cached();
                    ensure_caret_visible();
                    return true;
                case Event::Key::Up:
                    move_vertical(-1);
                    ensure_caret_visible();
                    return true;
                case Event::Key::Down:
                    move_vertical(1);
                    ensure_caret_visible();
                    return true;
                default:
                    break;
                }
                return true;
            }
        }
        return false;
    }

private:
    void insert_char(char c) {
        if (text_.size() >= StaticString<256>::max_size()) return;
        text_.insert(cursor_, 1, c);
        ++cursor_;
    }

    int cursor_row() const noexcept {
        int row = 0;
        for (int i = 0; i < cursor_ && i < static_cast<int>(text_.size()); ++i) {
            if (text_[i] == '\n') ++row;
        }
        return row;
    }

    int cursor_col(int inner_w, float avg_w) const noexcept {
        int col = 0;
        for (int i = 0; i < cursor_ && i < static_cast<int>(text_.size()); ++i) {
            if (text_[i] == '\n') col = 0;
            else ++col;
        }
        int max_col = static_cast<int>(inner_w / avg_w) - 1;
        if (max_col < 1) max_col = 1;
        return std::min(col, max_col);
    }

    int cursor_col_cached() const noexcept {
        int col = 0;
        for (int i = 0; i < cursor_ && i < static_cast<int>(text_.size()); ++i) {
            if (text_[i] == '\n') col = 0;
            else ++col;
        }
        return col;
    }

    void move_vertical(int dir) {
        int row = 0;
        int col = 0;
        for (int i = 0; i < cursor_ && i < static_cast<int>(text_.size()); ++i) {
            if (text_[i] == '\n') { ++row; col = 0; }
            else { ++col; }
        }
        int target_row = row + dir;
        if (target_row < 0) target_row = 0;

        int cur_row = 0;
        int idx = 0;
        while (idx < static_cast<int>(text_.size()) && cur_row < target_row) {
            if (text_[idx] == '\n') ++cur_row;
            ++idx;
        }
        int target_col = (desired_col_ >= 0) ? desired_col_ : col;
        int c = 0;
        while (idx < static_cast<int>(text_.size()) && text_[idx] != '\n' && c < target_col) {
            ++idx; ++c;
        }
        cursor_ = idx;
    }

    void ensure_caret_visible() {
        const Style& st = Theme::instance().get<TextArea>();
        const int line_h = line_height(resolve_font(st));
        const auto r = get_rect();
        const int inner_h = r.h - st.padding * 2;
        const int caret_y = cursor_row() * line_h;
        const int margin = line_h / 2;
        if (caret_y - scroll_y_px_ < margin) {
            scroll_y_px_ = caret_y - margin;
            if (scroll_y_px_ < 0) scroll_y_px_ = 0;
        } else if (caret_y - scroll_y_px_ > inner_h - line_h) {
            scroll_y_px_ = caret_y - (inner_h - line_h);
            if (scroll_y_px_ < 0) scroll_y_px_ = 0;
        }
    }

    StaticString<256> text_{};
    bool readonly_{true};
    int cursor_{0};
    int scroll_y_px_{0};
    int desired_col_{0};
};
