    "flowProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "flow_role",
        "source_summary_schema",
        "source_summary_path",
        "source_report_markdown_path",
        "source_check_text_path",
        "result",
        "expected_opener_count",
        "actual_opener_count",
        "available_projection_count",
        "compare_context_count",
        "inspector_ready_count",
        "blocked_inspector_count",
        "completed_step_count"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "flow_role": {
          "type": "string",
          "enum": [
            "baseline_flow",
            "candidate_flow"
          ]
