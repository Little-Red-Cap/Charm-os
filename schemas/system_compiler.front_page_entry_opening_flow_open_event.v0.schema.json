        "plan_id": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "execution_plan_status": {
          "type": "string"
        },
        "planned_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "default_action_id": {
          "type": "string"
        },
        "compare_action_id": {
          "type": "string"
        },
        "selected_action_id": {
          "type": "string"
        }
      }
    },
    "actionExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "projection_kind",
        "target_summary_schema",
        "target_summary_kind",
        "target_summary_path"
      ],
      "properties": {
        "operation": {
          "type": "string"
        },
        "projection_kind": {
          "type": "string"
        },
        "target_summary_schema": {
          "type": "string"
        },
        "target_summary_kind": {
          "type": "string"
        },
        "target_summary_path": {
          "type": "string"
        }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "opener_surface_available",
        "opener_summary_path",
        "blockers"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "opener_surface_available": {
          "type": "boolean"
        },
        "opener_summary_path": {
          "type": "string"
        },
        "blockers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "compareSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "summary_path",
        "action_verdict",
        "changed_field_count",
        "reason_changed",
        "narratives"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "summary_path": {
          "type": "string"
        },
        "action_verdict": {
          "type": "string",
          "enum": [
            "standing",
            "improved",
            "drifted",
            "collapsed",
            "not_attached"
          ]
        },
        "changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "reason_changed": {
          "type": "boolean"
        },
        "narratives": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "actionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "action_kind",
        "entry_name",
        "expected",
        "result",
        "compare"
      ],
      "properties": {
        "action_id": {
          "type": "string"
        },
        "action_kind": {
          "type": "string"
        },
        "entry_name": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/actionExpected"
        },
        "result": {
          "$ref": "#/$defs/actionResult"
        },
        "compare": {
          "$ref": "#/$defs/compareSummary"
        }
      }
    },
