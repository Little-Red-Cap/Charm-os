          "minimum": 0
        },
        "compare_context_lost_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_context_gained_count": {
          "type": "integer",
          "minimum": 0
        },
        "inspector_readiness_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "query_changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "target_changed_count": {
          "type": "integer",
          "minimum": 0
