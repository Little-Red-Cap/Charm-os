      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_field_count",
        "opening_identity_changed_field_count",
        "landing_decision_changed_field_count",
        "testimony_preview_changed_field_count",
        "artifact_target_changed_field_count",
        "next_question_changed_field_count"
      ],
      "properties": {
        "changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "opening_identity_changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "landing_decision_changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "testimony_preview_changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_target_changed_field_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_question_changed_field_count": {
          "type": "integer",
          "minimum": 0
        }
      }
