      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "changed"
      ],
      "properties": {
        "baseline": {},
        "candidate": {},
        "changed": {
          "type": "boolean"
        }
      }
    },
    "changeBlock": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/fieldChange"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "boolean"
          }
        ]
      },
      "required": [
        "changed_fields",
        "changed_field_count",
        "changed"
      ],
      "properties": {
        "changed_fields": {
          "$ref": "#/$defs/stringArray"
        },
        "changed_field_count": {
          "type": "integer",
          "minimum": 0
