{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_landing.v0.schema.json",
  "title": "system_compiler.front_page_entry_landing/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "entry_landing",
    "front_page",
    "route_provenance",
    "artifact_context",
    "root_surface",
    "landing_status",
    "fallback_mode_order",
    "primary_landing",
    "secondary_landings",
    "landing_tabs",
    "provenance_roots",
    "query_hints",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_landing/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_landing"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "entry_landing": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "route_provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeProvenanceEntry"
      }
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "root_surface": {
      "$ref": "#/$defs/rootSurface"
    },
    "landing_status": {
      "$ref": "#/$defs/landingStatus"
    },
    "fallback_mode_order": {
      "$ref": "#/$defs/stringArray"
    },
    "primary_landing": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/landingTab"
          }
        }
      ]
    },
    "secondary_landings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landingTab"
      }
    },
    "landing_tabs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/landingTab"
      }
    },
    "provenance_roots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenanceRoot"
      }
    },
    "query_hints": {
      "$ref": "#/$defs/queryHints"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "routeProvenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route_kind",
        "source_summary_schema",
        "source_summary_path",
        "source_input_summary_path",
        "source_root_summary_path",
        "source_report_markdown_path",
        "source_check_text_path",
        "level1_surface_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "route_kind": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_input_summary_path": {
          "type": "string"
        },
        "source_root_summary_path": {
          "type": "string"
        },
        "source_report_markdown_path": {
          "type": "string"
        },
        "source_check_text_path": {
          "type": "string"
        },
        "level1_surface_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_capability_summary_path",
        "output_root",
        "landing_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "input_capability_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "landing_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "rootSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "label",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path"
      ],
      "properties": {
        "surface_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        }
      }
    },
    "landingStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "landing_result",
        "recommended_entry_mode",
        "entry_tier",
        "primary_tab_id",
        "primary_summary_schema",
        "primary_summary_kind",
        "available_tab_ids",
        "fallback_tab_ids",
        "tab_count",
        "fallback_tab_count",
        "provenance_root_count",
        "route_provenance_entry_count",
        "direct_review_available",
        "direct_compare_available",
        "direct_biography_available",
        "direct_evidence_available"
      ],
      "properties": {
        "landing_result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "recommended_entry_mode": {
          "type": "string",
          "enum": [
            "review",
            "compare",
            "biography",
            "evidence",
            "route"
          ]
        },
        "entry_tier": {
          "type": "string",
          "enum": [
            "review_ready",
            "compare_ready",
            "biography_ready",
            "evidence_only",
            "route_only"
          ]
        },
        "primary_tab_id": {
          "$ref": "#/$defs/nullableString"
        },
        "primary_summary_schema": {
          "type": "string"
        },
        "primary_summary_kind": {
          "type": "string"
        },
        "available_tab_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "fallback_tab_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "tab_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_tab_count": {
          "type": "integer",
          "minimum": 0
        },
        "provenance_root_count": {
          "type": "integer",
          "minimum": 0
        },
        "route_provenance_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_review_available": {
          "type": "boolean"
        },
        "direct_compare_available": {
          "type": "boolean"
        },
        "direct_biography_available": {
          "type": "boolean"
        },
        "direct_evidence_available": {
          "type": "boolean"
        }
      }
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "depth",
        "surface_id",
        "label",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "revisit",
        "cycle",
        "expanded",
        "route_provenance_count",
        "supporting_surface_count"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "surface_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "revisit": {
          "type": "boolean"
        },
        "cycle": {
          "type": "boolean"
        },
        "expanded": {
          "type": "boolean"
        },
        "route_provenance_count": {
          "type": "integer",
          "minimum": 0
        },
        "supporting_surface_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "landingTab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "title",
        "capability_ids",
        "entry"
      ],
      "properties": {
        "tab_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "capability_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "entry": {
          "$ref": "#/$defs/entryRef"
        }
      }
    },
    "queryHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "tab_title",
        "entry_role",
        "summary_schema",
        "summary_kind",
        "scope",
        "selection_rule",
        "query_kind",
        "compare_expected",
        "followup_query_kinds",
        "rationale"
      ],
      "properties": {
        "tab_id": {
          "type": "string"
        },
        "tab_title": {
          "type": "string"
        },
        "entry_role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "report",
            "artifact_root"
          ]
        },
        "selection_rule": {
          "type": "string",
          "enum": [
            "single_report",
            "artifact_root_full",
            "artifact_root_or_subset"
          ]
        },
        "query_kind": {
          "type": "string",
          "enum": [
            "default_overview",
            "bringup_evidence",
            "resource_summary",
            "cap_list"
          ]
        },
        "compare_expected": {
          "type": "boolean"
        },
        "followup_query_kinds": {
          "$ref": "#/$defs/stringArray"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "queryHints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_query",
        "tab_queries"
      ],
      "properties": {
        "primary_query": {
          "type": [
            "object",
            "null"
          ],
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "$ref": "#/$defs/queryHint"
              }
            }
          ]
        },
        "tab_queries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/queryHint"
          }
        }
      }
    },
    "provenanceRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "root_kind",
        "source_summary_schema",
        "source_summary_path",
        "source_front_page_summary_path",
        "owner_route_ids",
        "owner_surface_ids",
        "available_supporting_surface_ids"
      ],
      "properties": {
        "root_id": {
          "type": "string"
        },
        "root_kind": {
          "type": "string"
        },
        "source_summary_schema": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "source_front_page_summary_path": {
          "type": "string"
        },
        "owner_route_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "owner_surface_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "available_supporting_surface_ids": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "root_kind": {
                "const": "artifact_report_index"
              }
            }
          },
          "then": {
            "properties": {
              "source_summary_schema": {
                "const": "system_compiler.artifact_report_index/v0"
              },
              "source_front_page_summary_path": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compare_questions",
        "next_questions"
      ],
      "properties": {
        "compare_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
