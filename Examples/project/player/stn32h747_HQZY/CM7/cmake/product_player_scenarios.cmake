elseif (PLAYER_PROFILE STREQUAL "USB_SELF_MSC")
    set(PLAYER_PROFILE_SOURCE app/main-usb-self-msc.cpp)
    set(PLAYER_PROFILE_MODULE_GROUPS
        MODULE_GROUP_PRODUCT_CONFIG
