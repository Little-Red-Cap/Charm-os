        "priority": {
          "type": "integer"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "changed": {
          "type": "boolean"
        },
        "headline": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "session_status_baseline": {
          "type": "string"
        },
        "session_status_current": {
          "type": "string"
        },
        "failure_domain_baseline": {
          "type": "string"
        },
        "failure_domain_current": {
          "type": "string"
        },
        "runtime_regressions": {
          "$ref": "#/$defs/stringArray"
        },
        "runtime_improvements": {
          "$ref": "#/$defs/stringArray"
        },
        "added_failure_codes": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_failure_codes": {
          "$ref": "#/$defs/stringArray"
        },
        "added_missing_runtime_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_missing_runtime_facts": {
          "$ref": "#/$defs/stringArray"
        },
        "added_affected_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_affected_focus": {
          "$ref": "#/$defs/stringArray"
        },
        "added_violations": {
          "$ref": "#/$defs/stringArray"
        },
        "removed_violations": {
          "$ref": "#/$defs/stringArray"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "preferred_explain_hop": {
          "$ref": "#/$defs/explainHop"
        },
        "summary_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "question_lines": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "readinessSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity_counts",
        "focus_kind_counts",
        "changed_focus_ids",
        "actionable_focus_ids"
      ],
      "properties": {
        "severity_counts": {
          "$ref": "#/$defs/stringIntegerMap"
        },
        "focus_kind_counts": {
          "$ref": "#/$defs/stringIntegerMap"
        },
        "changed_focus_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "actionable_focus_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer_questions",
        "next_questions"
      ],
      "properties": {
        "consumer_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
