            "json"
          ]
        },
        "arguments": {
          "$ref": "#/$defs/stringArray"
        },
        "powershell_command": {
          "$ref": "#/$defs/stringArray"
        },
        "blockers": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
