{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_flow_compare.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_flow_compare/v0",
