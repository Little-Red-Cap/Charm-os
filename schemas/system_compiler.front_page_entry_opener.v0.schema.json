{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opener.v0.schema.json",
  "title": "system_compiler.front_page_entry_opener/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "entry_opener",
    "front_page",
    "artifact_context",
    "source_landing",
    "source_landing_compare",
    "compare_context",
    "open_action",
    "inspector_invocation",
    "opened_projection",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opener/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opener"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "entry_opener": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "source_landing": {
      "$ref": "#/$defs/sourceLanding"
    },
    "source_landing_compare": {
      "type": [
        "object",
        "null"
      ],
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "$ref": "#/$defs/sourceLandingCompare"
          }
        }
      ]
    },
    "compare_context": {
      "$ref": "#/$defs/compareContext"
    },
    "open_action": {
      "$ref": "#/$defs/openAction"
    },
    "inspector_invocation": {
      "$ref": "#/$defs/inspectorInvocation"
    },
    "opened_projection": {
      "$ref": "#/$defs/openedProjection"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_landing_summary_path",
        "source_landing_compare_summary_path",
        "output_root",
        "opener_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_landing_summary_path": {
          "type": "string"
        },
        "source_landing_compare_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "opener_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "sourceLanding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_summary_path",
        "root_label",
        "root_summary_schema",
        "root_summary_kind",
        "root_summary_path",
        "landing_result",
        "recommended_entry_mode",
        "entry_tier",
        "opening_reason",
        "primary_tab_id",
        "available_tab_ids",
        "primary_entry",
        "primary_query"
      ],
      "properties": {
        "source_summary_path": {
          "type": "string"
        },
        "root_label": {
          "type": "string"
        },
        "root_summary_schema": {
          "type": "string"
        },
        "root_summary_kind": {
          "type": "string"
        },
        "root_summary_path": {
          "type": "string"
        },
        "landing_result": {
          "type": "string"
        },
        "recommended_entry_mode": {
          "type": "string"
        },
        "entry_tier": {
          "type": "string"
        },
        "opening_reason": {
          "$ref": "#/$defs/openingReason"
        },
        "primary_tab_id": {
          "type": "string"
        },
        "available_tab_ids": {
          "$ref": "#/$defs/stringArray"
        },
        "primary_entry": {
          "$ref": "#/$defs/primaryEntry"
        },
        "primary_query": {
          "$ref": "#/$defs/queryHint"
        }
      }
    },
    "primaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "title",
        "route_id",
        "surface_id",
        "role",
        "summary_schema",
        "summary_kind",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "tab_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "route_id": {
          "type": "string"
        },
        "surface_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_kind": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "openingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "source_summary_path",
        "drift_changed",
        "drift_verdict"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "world_shelf_review_drift",
            "world_shelf_review",
            "grouped_review",
            "counterfactual_verdict",
            "delivery_biography",
            "supporting_evidence",
            "route"
          ]
        },
        "summary": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "drift_changed": {
          "type": "boolean"
        },
        "drift_verdict": {
          "type": "string"
        }
      }
    },
    "queryHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tab_id",
        "tab_title",
        "entry_role",
        "summary_schema",
        "summary_kind",
        "scope",
        "selection_rule",
        "query_kind",
        "compare_expected",
        "followup_query_kinds",
        "rationale"
