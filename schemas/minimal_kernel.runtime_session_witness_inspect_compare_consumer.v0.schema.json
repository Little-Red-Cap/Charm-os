        "reason_kind": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "summary_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "question_lines": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "focusEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_id",
        "focus_kind",
        "priority",
        "severity",
        "changed",
        "headline",
        "reason",
        "session_status_baseline",
        "session_status_current",
        "failure_domain_baseline",
        "failure_domain_current",
        "runtime_regressions",
        "runtime_improvements",
        "added_failure_codes",
        "removed_failure_codes",
        "added_missing_runtime_facts",
        "removed_missing_runtime_facts",
        "added_affected_focus",
        "removed_affected_focus",
        "added_violations",
        "removed_violations",
        "artifact_refs",
        "preferred_explain_hop",
        "summary_lines",
        "question_lines"
