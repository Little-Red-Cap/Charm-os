{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/minimal_kernel.runtime_session_witness_inspect_compare_consumer.v0.schema.json",
  "title": "minimal_kernel.runtime_session_witness_inspect_compare_consumer/v0",
