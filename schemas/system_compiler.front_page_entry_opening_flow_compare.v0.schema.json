        "source_summary_path": {
          "type": "string"
        },
        "source_report_markdown_path": {
          "type": "string"
        },
        "source_check_text_path": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "expected_opener_count": {
          "type": "integer",
          "minimum": 0
        },
        "actual_opener_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_projection_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_context_count": {
          "type": "integer",
          "minimum": 0
        },
        "inspector_ready_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_inspector_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_step_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_flow_summary_path",
        "candidate_flow_summary_path",
