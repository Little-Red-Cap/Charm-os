{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://charm-os.local/schemas/system_compiler.front_page_entry_opening_flow_consumer_selector.v0.schema.json",
  "title": "system_compiler.front_page_entry_opening_flow_consumer_selector/v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "generated_at_utc",
    "generator",
    "result",
    "opening_flow_consumer_selector",
    "front_page",
    "artifact_context",
    "source_consumer",
    "selector_status",
    "open_plan",
    "questions",
    "violations"
  ],
  "properties": {
    "schema": {
      "const": "system_compiler.front_page_entry_opening_flow_consumer_selector/v0"
    },
    "kind": {
      "const": "system_compiler.front_page_entry_opening_flow_consumer_selector"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generator": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "opening_flow_consumer_selector": {
      "$ref": "#/$defs/titleBlock"
    },
    "front_page": {
      "$ref": "#/$defs/frontPage"
    },
    "artifact_context": {
      "$ref": "#/$defs/artifactContext"
    },
    "source_consumer": {
      "$ref": "#/$defs/sourceConsumer"
    },
    "selector_status": {
      "$ref": "#/$defs/selectorStatus"
    },
    "open_plan": {
      "$ref": "#/$defs/openPlan"
    },
    "questions": {
      "$ref": "#/$defs/questionBlock"
    },
    "violations": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "titleBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "frontPageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "role",
        "summary_schema",
        "summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "summary_schema": {
          "type": "string"
        },
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "frontPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_path",
        "report_markdown_path",
        "check_text_path",
        "supporting_surfaces"
      ],
      "properties": {
        "summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        },
        "supporting_surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontPageSurface"
          }
        }
      }
    },
    "artifactContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_consumer_summary_path",
        "output_root",
        "selector_summary_path",
        "report_markdown_path",
        "check_text_path"
      ],
      "properties": {
        "source_consumer_summary_path": {
          "type": "string"
        },
        "output_root": {
          "type": "string"
        },
        "selector_summary_path": {
          "type": "string"
        },
        "report_markdown_path": {
          "type": "string"
        },
        "check_text_path": {
          "type": "string"
        }
      }
    },
    "sourceConsumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "total_opening_count",
        "renderable_opening_count",
        "compare_aware_opening_count",
        "default_opening_name",
        "compare_opening_name"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "total_opening_count": {
          "type": "integer",
          "minimum": 0
        },
        "renderable_opening_count": {
          "type": "integer",
          "minimum": 0
        },
        "compare_aware_opening_count": {
          "type": "integer",
          "minimum": 0
        },
        "default_opening_name": {
          "type": "string"
        },
        "compare_opening_name": {
          "type": "string"
        }
      }
    },
    "selectorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "open_plan_status",
        "selected_entry_count",
        "default_entry_name",
        "compare_entry_name",
        "fallback_entry_count"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "ok",
            "fail"
          ]
        },
        "open_plan_status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "selected_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "default_entry_name": {
          "type": "string"
        },
        "compare_entry_name": {
          "type": "string"
        },
        "fallback_entry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "openPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "default_entry",
        "compare_entry",
        "fallback_entries",
        "ordered_entries",
        "selection_notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "blocked"
          ]
        },
        "default_entry": {
          "$ref": "#/$defs/entryOrEmpty"
        },
        "compare_entry": {
          "$ref": "#/$defs/entryOrEmpty"
        },
        "fallback_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectorEntry"
          }
        },
        "ordered_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectorEntry"
          }
        },
        "selection_notes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "entryOrEmpty": {
      "type": "object",
      "oneOf": [
        {
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/selectorEntry"
        }
      ]
    },
    "selectorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "name",
        "selected_tab_id",
        "selected_role",
        "query_kind",
        "query_scope",
        "target_summary_schema",
        "target_summary_kind",
        "target_summary_path",
        "projection_kind",
        "opening_reason",
        "projection_headline",
        "projection_summary_lines",
        "compare_context_available",
        "landing_verdict",
        "inspector_ready",
        "inspector_mode",
        "inspector_blockers",
        "opener_summary_path",
        "opener_report_markdown_path",
        "opener_check_text_path"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "selected_tab_id": {
          "type": "string"
        },
        "selected_role": {
          "type": "string"
        },
        "query_kind": {
          "type": "string"
        },
        "query_scope": {
          "type": "string"
        },
        "target_summary_schema": {
          "type": "string"
        },
        "target_summary_kind": {
          "type": "string"
        },
        "target_summary_path": {
          "type": "string"
        },
        "projection_kind": {
          "type": "string"
        },
        "opening_reason": {
          "$ref": "#/$defs/openingReason"
        },
        "projection_headline": {
          "type": "string"
        },
        "projection_summary_lines": {
          "$ref": "#/$defs/stringArray"
        },
        "compare_context_available": {
          "type": "boolean"
        },
        "landing_verdict": {
          "type": "string"
        },
        "inspector_ready": {
          "type": "boolean"
        },
        "inspector_mode": {
          "type": "string"
        },
        "inspector_blockers": {
          "$ref": "#/$defs/stringArray"
        },
        "opener_summary_path": {
          "type": "string"
        },
        "opener_report_markdown_path": {
          "type": "string"
        },
        "opener_check_text_path": {
          "type": "string"
        }
      }
    },
    "openingReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary",
        "source_summary_path",
        "drift_changed",
        "drift_verdict"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "world_shelf_review_drift",
            "world_shelf_review",
            "grouped_review",
            "counterfactual_verdict",
            "delivery_biography",
            "supporting_evidence",
            "route",
            ""
          ]
        },
        "summary": {
          "type": "string"
        },
        "source_summary_path": {
          "type": "string"
        },
        "drift_changed": {
          "type": "boolean"
        },
        "drift_verdict": {
          "type": "string"
        }
      }
    },
    "questionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_questions",
        "next_questions"
      ],
      "properties": {
        "selector_questions": {
          "$ref": "#/$defs/stringArray"
        },
        "next_questions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
